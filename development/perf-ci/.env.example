# Perf CI — local environment configuration
# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# Slack webhook for regression notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Perf analytics ingestion (Cloudflare Worker)
# If not set, analytics upload is silently skipped — CI will not break.
PERF_ANALYTICS_URL=https://perf-analytics.kaisheng-cai.workers.dev
# PERF_ANALYTICS_SECRET=your-secret-here
