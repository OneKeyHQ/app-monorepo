<?xml version="1.0" encoding="UTF-8"?>
<Window size="{{window.width}},{{window.height}}" caption="0,0,0,64" roundcorner="{{window.radius}},{{window.radius}}" gdiplustext="true">
  <Font id="0" name="{{font.family}}" size="{{font.bodySize}}" default="true" />
  <Font id="1" name="Segoe UI" size="24" />
  <Font id="2" name="Segoe UI Semibold" size="16" />
  <Font id="3" name="Segoe UI Semibold" size="13" />
  <Container name="page-root">
    <LightBackdrop float="0,0,1,1" canvascolor="{{color.canvas}}" bluecolor="{{color.blueTint}}" greencolor="{{color.greenTint}}" />
    <VerticalLayout float="0,0,1,1">
      <HorizontalLayout height="64" inset="24,18,22,10"><BrandMark width="28" height="28" brandcolor="{{color.brand}}" /><Label text="OneKey" font="2" textcolor="{{color.textPrimary}}" width="82" padding="9,0,0,0" /><Label name="version" text="{{runtime.version}}" textcolor="{{color.textSecondary}}" /><Button name="minbtn" text="—" textcolor="{{color.textSecondary}}" hotbkcolor="{{color.surfaceMuted}}" width="36" height="34" borderround="10,10" /><Control width="6" /><Button name="closebtn" text="×" textcolor="{{color.textSecondary}}" hottextcolor="{{color.danger}}" hotbkcolor="{{color.surfaceMuted}}" width="36" height="34" borderround="10,10" font="2" /></HorizontalLayout>
      <VerticalLayout inset="145,48,145,28">
        <HorizontalLayout height="82"><Control /><BrandMark width="82" height="82" brandcolor="{{color.brand}}" /><Control /></HorizontalLayout>
        <Control height="18" />
        <Label text="{{string.uninstall.title}}" font="1" textcolor="{{color.textPrimary}}" height="42" align="center" />
        <Label text="{{string.uninstall.subtitle}}" textcolor="{{color.textSecondary}}" height="32" align="center" />
        <Control height="46" />
        <GlassPanel height="120" bkcolor="{{color.heroSurface}}" bordercolor="{{color.border}}" bordersize="1" borderround="15,15" inset="24,20,24,8">
          <HorizontalLayout height="26"><Label name="status" text="{{runtime.status}}" textcolor="{{color.textPrimary}}" /><Label name="progress-value" text="{{runtime.progress}}%" font="3" textcolor="{{color.textPrimary}}" width="54" align="right" /></HorizontalLayout>
          <AnimatedProgress name="progress" height="28" value="{{runtime.progress}}" trackcolor="{{color.progressTrack}}" startcolor="{{color.progressStart}}" endcolor="{{color.brand}}" />
          <Label text="{{string.uninstall.subtitle}}" textcolor="{{color.textSecondary}}" height="32" />
        </GlassPanel>
        <Control />
      </VerticalLayout>
    </VerticalLayout>
  </Container>
</Window>
