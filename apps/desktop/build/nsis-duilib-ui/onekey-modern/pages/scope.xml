<?xml version="1.0" encoding="UTF-8"?>
<Window size="{{window.width}},{{window.height}}" caption="0,0,0,64" roundcorner="{{window.radius}},{{window.radius}}" gdiplustext="true">
  <Font id="0" name="{{font.family}}" size="{{font.bodySize}}" default="true" />
  <Font id="1" name="Segoe UI" size="24" />
  <Font id="2" name="Segoe UI Semibold" size="16" />
  <Font id="3" name="Segoe UI Semibold" size="13" />
  <Container name="page-root">
    <LightBackdrop float="0,0,1,1" canvascolor="{{color.canvas}}" bluecolor="{{color.blueTint}}" greencolor="{{color.greenTint}}" />
    <VerticalLayout float="0,0,1,1">
      <HorizontalLayout height="64" inset="24,18,22,10"><BrandMark width="28" height="28" brandcolor="{{color.brand}}" /><Label text="OneKey" font="2" textcolor="{{color.textPrimary}}" width="82" padding="9,0,0,0" /><Label text="{{runtime.version}}" textcolor="{{color.textSecondary}}" /><Button name="minbtn" text="—" textcolor="{{color.textSecondary}}" hotbkcolor="{{color.surfaceMuted}}" width="36" height="34" borderround="10,10" /><Control width="6" /><Button name="closebtn" text="×" textcolor="{{color.textSecondary}}" hottextcolor="{{color.danger}}" hotbkcolor="{{color.surfaceMuted}}" width="36" height="34" borderround="10,10" font="2" /></HorizontalLayout>
      <VerticalLayout inset="130,56,130,52">
        <Label text="{{string.scope.title}}" font="1" textcolor="{{color.textPrimary}}" height="40" align="center" />
        <Label text="{{string.scope.subtitle}}" textcolor="{{color.textSecondary}}" height="42" align="center" />
        <Control height="32" />
        <Button name="scope-current" text="{{string.scope.current.title}}  ·  {{string.scope.current.description}}" textcolor="{{color.ink}}" bkcolor="{{color.brand}}" hotbkcolor="{{color.brandHover}}" pushedbkcolor="{{color.brandPressed}}" bordercolor="{{color.brand}}" bordersize="1" borderround="14,14" height="82" font="3" />
        <Control height="16" />
        <Button name="scope-all" text="{{string.scope.all.title}}  ·  {{string.scope.all.description}}" textcolor="{{color.textPrimary}}" hotbkcolor="#DDF4FFF0" bkcolor="#CCFFFFFF" bordercolor="{{color.border}}" bordersize="1" borderround="14,14" height="82" font="3" />
        <Control />
      </VerticalLayout>
    </VerticalLayout>
  </Container>
</Window>
