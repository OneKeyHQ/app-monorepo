<?xml version="1.0" encoding="UTF-8"?>
<Window size="{{window.width}},{{window.height}}" caption="0,0,0,64" roundcorner="{{window.radius}},{{window.radius}}" gdiplustext="true">
  <Font id="0" name="{{font.family}}" size="{{font.bodySize}}" default="true" />
  <Font id="1" name="Segoe UI" size="24" />
  <Font id="2" name="Segoe UI Semibold" size="16" />
  <Font id="3" name="Segoe UI Semibold" size="13" />
  <Container name="page-root">
    <LightBackdrop float="0,0,1,1" canvascolor="{{color.canvas}}" bluecolor="{{color.blueTint}}" greencolor="{{color.greenTint}}" />
    <VerticalLayout float="0,0,1,1">
      <HorizontalLayout height="64" inset="24,15,22,15" childvalign="vcenter">
        <BrandMark width="28" height="28" brandcolor="{{color.brand}}" />
        <Label text="OneKey" font="2" textcolor="{{color.textPrimary}}" width="82" height="28" padding="9,0,0,0" />
        <Label name="version" text="{{runtime.version}}" textcolor="{{color.textSecondary}}" height="28" />
        <CaptionButton name="minbtn" kind="minimize" iconcolor="{{color.textSecondary}}" hoticoncolor="{{color.textPrimary}}" hotbkcolor="{{color.surfaceMuted}}" pushedbkcolor="{{color.surfaceStrong}}" width="36" height="34" borderround="10,10" />
        <Control width="6" />
        <CaptionButton name="closebtn" kind="close" iconcolor="{{color.textSecondary}}" hoticoncolor="{{color.danger}}" hotbkcolor="{{color.surfaceMuted}}" pushedbkcolor="{{color.surfaceStrong}}" width="36" height="34" borderround="10,10" />
      </HorizontalLayout>
      <VerticalLayout inset="155,54,155,44">
        <GlassPanel height="370" bkcolor="{{color.heroSurface}}" bordercolor="{{color.border}}" bordersize="1" borderround="18,18" inset="52,38,52,36">
          <HorizontalLayout height="76"><Control /><Label text="!" font="1" textcolor="{{color.danger}}" bkcolor="{{color.dangerSoft}}" width="76" height="76" borderround="38,38" align="center" /><Control /></HorizontalLayout>
          <Control height="24" />
          <Label text="{{string.confirmExit.title}}" font="1" textcolor="{{color.textPrimary}}" height="44" align="center" />
          <Label text="{{string.confirmExit.description}}" textcolor="{{color.textSecondary}}" height="56" align="center" />
          <Control height="32" />
          <HorizontalLayout height="48">
            <Control />
            <Button name="exit-stay" text="{{string.confirmExit.stay}}" textcolor="{{color.ink}}" bkcolor="{{color.brand}}" hotbkcolor="{{color.brandHover}}" pushedbkcolor="{{color.brandPressed}}" width="190" height="48" borderround="11,11" font="3" />
            <Control width="14" />
            <Button name="exit-confirm" text="{{string.confirmExit.confirm}}" textcolor="{{color.danger}}" hottextcolor="{{color.danger}}" bkcolor="{{color.surface}}" hotbkcolor="{{color.dangerSoft}}" pushedbkcolor="{{color.surfaceStrong}}" bordercolor="{{color.border}}" bordersize="1" width="150" height="48" borderround="11,11" font="3" />
            <Control />
          </HorizontalLayout>
        </GlassPanel>
        <Control />
      </VerticalLayout>
    </VerticalLayout>
  </Container>
</Window>
