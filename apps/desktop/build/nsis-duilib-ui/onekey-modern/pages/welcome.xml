<?xml version="1.0" encoding="UTF-8"?>
<Window size="{{window.width}},{{window.height}}" caption="0,0,0,64" roundcorner="{{window.radius}},{{window.radius}}" gdiplustext="true">
  <Font id="0" name="{{font.family}}" size="{{font.bodySize}}" default="true" />
  <Font id="1" name="Segoe UI" size="24" />
  <Font id="2" name="Segoe UI Semibold" size="16" />
  <Font id="3" name="Segoe UI Semibold" size="13" />
  <Container name="page-root">
    <LightBackdrop float="0,0,1,1" canvascolor="{{color.canvas}}" bluecolor="{{color.blueTint}}" greencolor="{{color.greenTint}}" />
    <VerticalLayout float="0,0,1,1">
      <HorizontalLayout height="64" inset="24,18,22,10">
        <BrandMark width="28" height="28" brandcolor="{{color.brand}}" />
        <Label text="OneKey" font="2" textcolor="{{color.textPrimary}}" width="82" padding="9,0,0,0" />
        <Label text="{{runtime.version}}" textcolor="{{color.textSecondary}}" />
        <Button name="minbtn" text="—" textcolor="{{color.textSecondary}}" hottextcolor="{{color.textPrimary}}" hotbkcolor="{{color.surfaceMuted}}" width="36" height="34" borderround="10,10" />
        <Control width="6" />
        <Button name="closebtn" text="×" textcolor="{{color.textSecondary}}" hottextcolor="{{color.danger}}" hotbkcolor="{{color.surfaceMuted}}" width="36" height="34" borderround="10,10" font="2" />
      </HorizontalLayout>
      <VerticalLayout inset="145,46,145,26">
        <HorizontalLayout height="82"><Control /><BrandMark width="82" height="82" brandcolor="{{color.brand}}" /><Control /></HorizontalLayout>
        <Control height="30" />
        <Label text="{{string.welcome.title}}" font="1" textcolor="{{color.textPrimary}}" height="38" align="center" />
        <Label text="{{string.welcome.subtitle}}" textcolor="{{color.textSecondary}}" height="34" align="center" />
        <Control height="12" />
        <HorizontalLayout height="48"><Control /><Button name="primary" text="{{string.welcome.start}}" textcolor="{{color.ink}}" bkcolor="{{color.brand}}" hotbkcolor="{{color.brandHover}}" pushedbkcolor="{{color.brandPressed}}" width="220" height="48" borderround="11,11" font="3" /><Control /></HorizontalLayout>
        <Control height="18" />
        <HorizontalLayout height="46">
          <Control />
          <HorizontalLayout width="540" bkcolor="#B8FFFFFF" bordercolor="{{color.border}}" bordersize="1" borderround="10,10" inset="15,0,14,0">
            <Label name="install-directory" text="{{runtime.installDirectory}}" textcolor="{{color.textSecondary}}" padding="9,0,0,0" />
            <Button name="browse" text="{{string.welcome.change}}" textcolor="{{color.textSecondary}}" hottextcolor="{{color.textPrimary}}" bkcolor="#00FFFFFF" width="46" />
          </HorizontalLayout>
          <Control />
        </HorizontalLayout>
        <Label text="{{string.welcome.terms}}" textcolor="{{color.textSecondary}}" height="38" padding="0,12,0,0" align="center" />
        <Control />
      </VerticalLayout>
    </VerticalLayout>
  </Container>
</Window>
