<?xml version="1.0" encoding="UTF-8"?>
<Window size="{{window.width}},{{window.height}}" caption="0,0,0,64" roundcorner="{{window.radius}},{{window.radius}}" gdiplustext="true">
  <Font id="0" name="{{font.family}}" size="{{font.bodySize}}" default="true" />
  <Font id="1" name="{{font.family}}" size="{{font.titleSize}}" bold="true" />
  <Font id="2" name="{{font.family}}" size="19" bold="true" />
  <Font id="3" name="{{font.family}}" size="12" bold="true" />
  <HorizontalLayout name="page-root" bkcolor="{{color.surface}}">
    <VerticalLayout width="348" bkcolor="{{color.heroBackground}}" inset="36,34,36,34">
      <HorizontalLayout height="36">
        <BrandMark width="30" height="30" bkcolor="{{color.brand}}" borderround="9,9" />
        <Label text="OneKey" font="2" textcolor="{{color.textOnDark}}" padding="12,0,0,0" />
      </HorizontalLayout>
      <Control height="90" />
      <Label text="{{string.feature.eyebrow}}" font="3" textcolor="{{color.brand}}" height="28" />
      <Text text="{{feature.title}}" font="1" textcolor="{{color.textOnDark}}" height="88" wordbreak="true" />
      <Text text="{{feature.description}}" textcolor="{{color.textOnDarkSecondary}}" height="102" wordbreak="true" />
      <Control />
      <HorizontalLayout height="36">
        <Button name="feature-prev" text="‹" textcolor="{{color.textOnDark}}" bkcolor="{{color.heroSurface}}" hotbkcolor="{{color.brandPressed}}" width="36" height="36" borderround="10,10" font="2" />
        <Control width="10" />
        <Button name="feature-next" text="›" textcolor="{{color.textOnDark}}" bkcolor="{{color.heroSurface}}" hotbkcolor="{{color.brandPressed}}" width="36" height="36" borderround="10,10" font="2" />
        <Control />
        <Label name="feature-counter" text="{{feature.position}} / {{feature.count}}" textcolor="{{color.textOnDarkSecondary}}" width="48" align="right" />
      </HorizontalLayout>
    </VerticalLayout>
    <VerticalLayout bkcolor="{{color.surface}}">
      <HorizontalLayout height="64" inset="28,16,18,8">
        <Label text="{{string.app.name}}" font="3" textcolor="{{color.textSecondary}}" />
        <Button name="minbtn" text="—" textcolor="{{color.textSecondary}}" hotbkcolor="{{color.surfaceMuted}}" width="36" height="36" borderround="10,10" />
        <Control width="8" />
        <Button name="closebtn" text="×" textcolor="{{color.textSecondary}}" hottextcolor="{{color.danger}}" hotbkcolor="{{color.surfaceMuted}}" width="36" height="36" borderround="10,10" font="2" />
      </HorizontalLayout>
      <VerticalLayout inset="64,70,64,42">
        <Label text="{{string.welcome.title}}" font="1" textcolor="{{color.textPrimary}}" height="52" />
        <Text text="{{string.welcome.subtitle}}" textcolor="{{color.textSecondary}}" height="76" wordbreak="true" />
        <Control height="40" />
        <Label text="✓  {{string.install.safeHint}}" textcolor="{{color.textPrimary}}" height="44" />
        <Label text="✓  Windows 10 / 11 · x64 / ARM64" textcolor="{{color.textPrimary}}" height="44" />
        <Control />
        <Button name="primary" text="{{string.welcome.start}}" textcolor="{{color.heroBackground}}" bkcolor="{{color.brand}}" hotbkcolor="{{color.brandHover}}" pushedbkcolor="{{color.brandPressed}}" height="48" borderround="12,12" font="3" />
        <Label text="{{string.welcome.terms}}" textcolor="{{color.textSecondary}}" height="44" padding="0,12,0,0" align="center" />
      </VerticalLayout>
    </VerticalLayout>
  </HorizontalLayout>
</Window>
