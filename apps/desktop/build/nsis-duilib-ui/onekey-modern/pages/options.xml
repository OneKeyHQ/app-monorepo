<?xml version="1.0" encoding="UTF-8"?>
<Window size="{{window.width}},{{window.height}}" caption="0,0,0,64" roundcorner="{{window.radius}},{{window.radius}}" gdiplustext="true">
  <Font id="0" name="{{font.family}}" size="{{font.bodySize}}" default="true" />
  <Font id="1" name="{{font.family}}" size="{{font.titleSize}}" bold="true" />
  <Font id="2" name="{{font.family}}" size="19" bold="true" />
  <Font id="3" name="{{font.family}}" size="12" bold="true" />
  <HorizontalLayout name="page-root" bkcolor="{{color.surface}}">
    <VerticalLayout width="348" bkcolor="{{color.heroBackground}}" inset="36,34,36,34">
      <HorizontalLayout height="36">
        <BrandMark width="30" height="30" bkcolor="{{color.brand}}" borderround="9,9" />
        <Label text="OneKey" font="2" textcolor="{{color.textOnDark}}" padding="12,0,0,0" />
      </HorizontalLayout>
      <Control height="110" />
      <Label text="{{string.feature.eyebrow}}" font="3" textcolor="{{color.brand}}" height="28" />
      <Text text="{{feature.title}}" font="1" textcolor="{{color.textOnDark}}" height="88" wordbreak="true" />
      <Text text="{{feature.description}}" textcolor="{{color.textOnDarkSecondary}}" height="102" wordbreak="true" />
      <Control />
    </VerticalLayout>
    <VerticalLayout bkcolor="{{color.surface}}">
      <HorizontalLayout height="64" inset="28,16,18,8">
        <Label text="{{string.app.name}}" font="3" textcolor="{{color.textSecondary}}" />
        <Button name="closebtn" text="×" textcolor="{{color.textSecondary}}" hottextcolor="{{color.danger}}" hotbkcolor="{{color.surfaceMuted}}" width="36" height="36" borderround="10,10" font="2" />
      </HorizontalLayout>
      <VerticalLayout inset="64,70,64,44">
        <Label text="{{string.options.title}}" font="1" textcolor="{{color.textPrimary}}" height="52" />
        <Text text="{{string.options.subtitle}}" textcolor="{{color.textSecondary}}" height="70" wordbreak="true" />
        <Control height="44" />
        <Label text="{{string.options.pathLabel}}" font="3" textcolor="{{color.textPrimary}}" height="30" />
        <HorizontalLayout height="52" bkcolor="{{color.surfaceMuted}}" bordercolor="{{color.border}}" bordersize="1" borderround="12,12" inset="16,4,6,4">
          <Label name="install-directory" text="{{runtime.installDirectory}}" textcolor="{{color.textPrimary}}" />
          <Button name="browse" text="{{string.options.browse}}" textcolor="{{color.textPrimary}}" hotbkcolor="{{color.border}}" width="76" height="40" borderround="9,9" />
        </HorizontalLayout>
        <Control />
        <Button name="primary" text="{{string.options.install}}" textcolor="{{color.heroBackground}}" bkcolor="{{color.brand}}" hotbkcolor="{{color.brandHover}}" pushedbkcolor="{{color.brandPressed}}" height="48" borderround="12,12" font="3" />
        <Label text="{{string.install.version}}" textcolor="{{color.textSecondary}}" height="32" padding="0,12,0,0" align="center" />
      </VerticalLayout>
    </VerticalLayout>
  </HorizontalLayout>
</Window>
