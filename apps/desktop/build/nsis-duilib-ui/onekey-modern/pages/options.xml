<?xml version="1.0" encoding="UTF-8"?>
<Window size="{{window.width}},{{window.height}}" caption="0,0,0,64" roundcorner="{{window.radius}},{{window.radius}}" gdiplustext="true">
  <Font id="0" name="{{font.family}}" size="{{font.bodySize}}" default="true" />
  <Font id="1" name="Segoe UI" size="24" />
  <Font id="2" name="Segoe UI Semibold" size="16" />
  <Font id="3" name="Segoe UI Semibold" size="13" />
  <Container name="page-root">
    <LightBackdrop float="0,0,1,1" canvascolor="{{color.canvas}}" bluecolor="{{color.blueTint}}" greencolor="{{color.greenTint}}" />
    <VerticalLayout float="0,0,1,1">
      <HorizontalLayout height="64" inset="24,15,22,15" childvalign="vcenter"><BrandMark width="28" height="28" brandcolor="{{color.brand}}" /><Label text="OneKey" font="2" textcolor="{{color.textPrimary}}" width="82" height="28" padding="9,0,0,0" /><Label text="{{runtime.version}}" textcolor="{{color.textSecondary}}" height="28" /><CaptionButton name="minbtn" kind="minimize" iconcolor="{{color.textSecondary}}" hoticoncolor="{{color.textPrimary}}" hotbkcolor="{{color.surfaceMuted}}" pushedbkcolor="{{color.surfaceStrong}}" width="36" height="34" borderround="10,10" /><Control width="6" /><CaptionButton name="closebtn" kind="close" iconcolor="{{color.textSecondary}}" hoticoncolor="{{color.danger}}" hotbkcolor="{{color.surfaceMuted}}" pushedbkcolor="{{color.surfaceStrong}}" width="36" height="34" borderround="10,10" /></HorizontalLayout>
      <VerticalLayout inset="145,84,145,42">
        <Label text="{{string.options.title}}" font="1" textcolor="{{color.textPrimary}}" height="40" align="center" />
        <Label text="{{string.options.subtitle}}" textcolor="{{color.textSecondary}}" height="34" align="center" />
        <Control height="44" />
        <HorizontalLayout height="46" bkcolor="#B8FFFFFF" bordercolor="{{color.border}}" bordersize="1" borderround="10,10" inset="15,0,14,0" childvalign="vcenter"><Label name="install-directory" text="{{runtime.installDirectory}}" textcolor="{{color.textSecondary}}" /><Button name="browse" text="{{string.options.browse}}" textcolor="{{color.textSecondary}}" hottextcolor="{{color.textPrimary}}" bkcolor="#00FFFFFF" hotbkcolor="{{color.surfaceMuted}}" pushedbkcolor="{{color.surfaceStrong}}" width="46" height="34" borderround="8,8" /></HorizontalLayout>
        <Control height="28" />
        <HorizontalLayout height="48"><Control /><Button name="primary" text="{{string.options.install}}" textcolor="{{color.ink}}" bkcolor="{{color.brand}}" hotbkcolor="{{color.brandHover}}" pushedbkcolor="{{color.brandPressed}}" width="220" height="48" borderround="11,11" font="3" /><Control /></HorizontalLayout>
        <Control />
        <Label text="{{string.install.safeHint}}" textcolor="{{color.textSecondary}}" height="34" align="center" />
      </VerticalLayout>
    </VerticalLayout>
  </Container>
</Window>
