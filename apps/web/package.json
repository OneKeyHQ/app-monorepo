{
  "name": "@onekeyhq/web",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" webpack serve",
    "start:rspack": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" rspack serve",
    "start:proxy": "ONEKEY_PROXY=true bun run start",
    "clean": "bun run clean:build",
    "clean:build": "rimraf ./web-build && rimraf .tamagui && rimraf ./node_modules/.cache",
    "build": "bun run clean && cross-env NODE_ENV=production webpack build && cp ./web-build/index.html ./web-build/404.html && bash ./postbuild.sh",
    "build:rspack": "bun run clean && cross-env NODE_ENV=production rspack build && cp ./web-build/index.html ./web-build/404.html && bash ./postbuild.sh",
    "_folderslint": "bun run folderslint"
  },
  "dependencies": {
    "@onekeyhq/components": "workspace:*",
    "@onekeyhq/core": "workspace:*",
    "@onekeyhq/kit": "workspace:*",
    "@onekeyhq/kit-bg": "workspace:*",
    "@onekeyhq/shared": "workspace:*"
  },
  "devDependencies": {
    "folderslint": "1.2.0",
    "rimraf": "3.0.2"
  },
  "private": true
}
