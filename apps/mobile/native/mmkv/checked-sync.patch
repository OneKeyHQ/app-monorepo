+bool journalTransfer(int fd, void *bytes, size_t length, bool writing) {
+    auto ptr = static_cast<uint8_t *>(bytes);
+    size_t offset = 0;
+    while (offset < length) {
+        ssize_t count = writing ? pwrite(fd, ptr + offset, length - offset, static_cast<off_t>(offset)) :
+                                  pread(fd, ptr + offset, length - offset, static_cast<off_t>(offset));
+        if (count < 0 && errno == EINTR) { continue; }
+        if (count <= 0) { if (count == 0) { errno = EIO; } return false; }
+        offset += static_cast<size_t>(count);
+    }
+    return true;
