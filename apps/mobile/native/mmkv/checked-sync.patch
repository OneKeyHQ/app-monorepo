+int MemoryFile::validateMappedPath() const {
+    if (!m_ptr || !m_size || !m_hasMappedIdentity) {
+        return EAGAIN;
+    }
+    struct stat pathStat = {};
+    int result;
+    do {
+        result = ::lstat(m_diskFile.getPath().c_str(), &pathStat);
+    } while (result < 0 && errno == EINTR);
+    if (result < 0) {
+        return errno;
+    }
+    if (!S_ISREG(pathStat.st_mode) || pathStat.st_dev != m_mappedDevice ||
+        pathStat.st_ino != m_mappedInode || pathStat.st_size < m_size) {
+        return ESTALE;
+    }
+    return 0;
+}
+
+int MemoryFile::syncChecked() {
+    if (m_readOnly) {
+        return EROFS;
+    }
+    int error = validateMappedPath();
+    if (error) {
+        return error;
+    }
+    // getFd() may reopen a mayfly descriptor with O_CREAT. Open the mapped
+    // inode independently without creation, and keep it pinned until fsync.
+    int fd;
+    do {
+        fd = ::open(m_diskFile.getPath().c_str(), O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+    } while (fd < 0 && errno == EINTR);
+    if (fd < 0) {
+        return errno;
+    }
+    struct CloseDescriptor {
+        int fd;
+        ~CloseDescriptor() { ::close(fd); }
+    } closeDescriptor{fd};
+    struct stat diskStat = {};
+    int result;
+    do {
+        result = ::fstat(fd, &diskStat);
+    } while (result < 0 && errno == EINTR);
+    if (result < 0) {
+        return errno;
+    }
+    if (!S_ISREG(diskStat.st_mode) || diskStat.st_dev != m_mappedDevice ||
+        diskStat.st_ino != m_mappedInode || diskStat.st_size < m_size) {
+        return ESTALE;
+    }
+    do {
+        result = ::msync(m_ptr, m_size, MS_SYNC);
+    } while (result < 0 && errno == EINTR);
+    if (result < 0) {
+        return errno;
+    }
+    do {
+        result = ::fsync(fd);
+    } while (result < 0 && errno == EINTR);
+    if (result < 0) {
+        return errno;
+    }
+    return validateMappedPath();
+}
