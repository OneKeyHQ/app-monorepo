+        if (!name) { errno = EACCES; return false; }
+        (void) dataPath; (void) metaPath;
+#else
+        auto manager = [NSFileManager defaultManager];
+        NSString *dataName = [NSString stringWithUTF8String:dataPath.c_str()];
+        NSString *metaName = [NSString stringWithUTF8String:metaPath.c_str()];
+        auto dataAttributes = [manager attributesOfItemAtPath:dataName error:nullptr];
+        auto metaAttributes = [manager attributesOfItemAtPath:metaName error:nullptr];
+        NSString *dataProtection = [dataAttributes objectForKey:NSFileProtectionKey];
+        NSString *metaProtection = [metaAttributes objectForKey:NSFileProtectionKey];
+        if (!name || !dataProtection || !metaProtection) { errno = EACCES; return false; }
+        // Complete is at least as restrictive when the two source classes differ.
+        NSString *protection = [dataProtection isEqualToString:metaProtection] ? dataProtection : NSFileProtectionComplete;
+        if (![manager setAttributes:@{NSFileProtectionKey: protection} ofItemAtPath:name error:nullptr]) {
+            errno = EACCES;
+            return false;
+        }
+#endif
+        NSURL *url = [NSURL fileURLWithPath:name];
+        if (![url setResourceValue:@YES forKey:NSURLIsExcludedFromBackupKey error:nullptr]) {
+            errno = EACCES;
+            return false;
+        }
+        return true;
+    }
+#else
+    (void) temporary; (void) dataPath; (void) metaPath;
+    return true;
+#endif
+}
+
+bool journalValidateCanonical(const string &mmapID, const string &path) {
+    bool dataExists, metaExists;
+    if (!journalPathExists(path, dataExists) || !journalPathExists(path + ".crc", metaExists)) { return false; }
+    if (!dataExists && !metaExists) { return true; }
+    if (!dataExists || !metaExists) { errno = ENOENT; return false; }
+    JournalFD data(journalOpen(path, O_RDONLY)), meta(journalOpen(path + ".crc", O_RDONLY));
+    struct stat dataStatus = {}, metaStatus = {};
+    if (data.fd < 0 || meta.fd < 0 || !journalRegular(data.fd, dataStatus) || !journalRegular(meta.fd, metaStatus) ||
+        dataStatus.st_size < Fixed32Size || metaStatus.st_size < static_cast<off_t>(sizeof(MMKVMetaInfo))) { return false; }
+    MMKVMetaInfo info;
+    uint32_t actual;
+    if (!journalTransfer(meta.fd, &info, sizeof(info), false) || !journalTransfer(data.fd, &actual, sizeof(actual), false)) { return false; }
+    if (info.m_version >= MMKVVersionActualSize) { actual = info.m_actualSize; }
+    if (actual > uint64_t(dataStatus.st_size) - Fixed32Size) { errno = EILSEQ; return false; }
+    vector<uint8_t> prefix(static_cast<size_t>(actual) + Fixed32Size);
+    size_t prefixLength;
+    if (!journalTransfer(data.fd, prefix.data(), prefix.size(), false)) { return false; }
+    const bool healthy = journalHealthy(prefix.data(), prefix.size(), &info, sizeof(info), prefixLength);
+    if (!healthy) {
+        const auto computed = CRC32(0, prefix.data() + Fixed32Size, actual);
+        traceAppStorageIntegrity(mmapID, path, "load-rejected", info, actual, computed,
+                                 dataStatus.st_size, 0, EILSEQ, true);
+    }
+    return healthy;
+}
+
+bool journalRecover(const string &mmapID, const string &path, bool readOnly) {
+    const auto pending = path + AppStorageJournalSuffix;
+    bool exists;
+    if (!journalPathExists(pending, exists)) { return false; }
+    if (!exists) { return journalValidateCanonical(mmapID, path); }
+    if (readOnly) { errno = EROFS; return false; }
+    JournalFD journal(journalOpen(pending, O_RDONLY));
+    struct stat journalStatus = {};
+    if (journal.fd < 0 || !journalRegular(journal.fd, journalStatus) ||
+        journalStatus.st_size < static_cast<off_t>(sizeof(AppStorageJournalHeader))) { return false; }
+    AppStorageJournalHeader header;
+    if (!journalTransfer(journal.fd, &header, sizeof(header), false)) { return false; }
+    const AppStorageJournalHeader expected;
+    if (memcmp(header.magic, expected.magic, sizeof(header.magic)) != 0 || header.version != 1 ||
+        header.headerSize != sizeof(header) || header.reserved != 0 || header.dataLength < Fixed32Size ||
+        header.dataLength > header.dataFileSize || header.dataLength > UINT32_MAX + uint64_t(Fixed32Size) ||
+        header.metaFileSize < sizeof(MMKVMetaInfo) || header.metaFileSize > 1024 * 1024 ||
+        header.dataFileSize > INT64_MAX || header.metaFileSize + header.dataLength + sizeof(header) != uint64_t(journalStatus.st_size)) {
+        errno = EILSEQ;
+        return false;
+    }
+    vector<uint8_t> bytes(static_cast<size_t>(journalStatus.st_size));
+    if (!journalTransfer(journal.fd, bytes.data(), bytes.size(), false)) { return false; }
+    const auto checksum = header.checksum;
+    auto unchecked = header;
+    unchecked.checksum = 0;
+    memcpy(bytes.data(), &unchecked, sizeof(unchecked));
+    if (CRC32(0, bytes.data(), bytes.size()) != checksum) { errno = EILSEQ; return false; }
+    auto meta = bytes.data() + sizeof(header);
+    auto data = meta + header.metaFileSize;
+    size_t prefixLength;
+    if (!journalHealthy(data, header.dataLength, meta, header.metaFileSize, prefixLength) || prefixLength != header.dataLength) {
+        errno = EILSEQ;
+        return false;
+    }
+    JournalFD dataFile(journalOpen(path, O_RDWR));
+    JournalFD metaFile(journalOpen(path + ".crc", O_RDWR));
+    struct stat dataStatus = {}, metaStatus = {};
+    if (dataFile.fd < 0 || metaFile.fd < 0 || !journalRegular(dataFile.fd, dataStatus) || !journalRegular(metaFile.fd, metaStatus)) { return false; }
+    if (uint64_t(dataStatus.st_dev) != header.dataDevice || uint64_t(dataStatus.st_ino) != header.dataInode ||
+        uint64_t(metaStatus.st_dev) != header.metaDevice || uint64_t(metaStatus.st_ino) != header.metaInode) {
+        errno = ESTALE;
+        return false;
+    }
+    // Keep the journal throughout both in-place restores, including a second crash.
+    if (ftruncate(dataFile.fd, static_cast<off_t>(header.dataFileSize)) != 0 ||
+        !journalTransfer(dataFile.fd, data, header.dataLength, true) || !journalSync(dataFile.fd) ||
+        ftruncate(metaFile.fd, static_cast<off_t>(header.metaFileSize)) != 0 ||
+        !journalTransfer(metaFile.fd, meta, header.metaFileSize, true) || !journalSync(metaFile.fd)) { return false; }
+    vector<uint8_t> restoredData(header.dataLength), restoredMeta(header.metaFileSize);
+    if (!journalTransfer(dataFile.fd, restoredData.data(), restoredData.size(), false) ||
+        !journalTransfer(metaFile.fd, restoredMeta.data(), restoredMeta.size(), false) ||
+        restoredData != vector<uint8_t>(data, data + header.dataLength) ||
+        restoredMeta != vector<uint8_t>(meta, meta + header.metaFileSize)) { errno = EIO; return false; }
+    struct stat dataPathStatus = {}, metaPathStatus = {}, pendingStatus = {};
+    if (lstat(path.c_str(), &dataPathStatus) != 0 || lstat((path + ".crc").c_str(), &metaPathStatus) != 0 ||
+        lstat(pending.c_str(), &pendingStatus) != 0 ||
+        dataPathStatus.st_dev != dataStatus.st_dev || dataPathStatus.st_ino != dataStatus.st_ino ||
+        metaPathStatus.st_dev != metaStatus.st_dev || metaPathStatus.st_ino != metaStatus.st_ino ||
+        pendingStatus.st_dev != journalStatus.st_dev || pendingStatus.st_ino != journalStatus.st_ino) { errno = ESTALE; return false; }
+    return unlink(pending.c_str()) == 0 && journalDirectorySync(path);
+}
+} // namespace
+#endif
+
+bool MMKV::appStoragePathHasTransaction(const MMKVPath_t &path) {
+#ifndef MMKV_WIN32
+    bool exists;
+    return !journalPathExists(path + AppStorageJournalSuffix, exists) || exists;
+#else
+    (void) path;
+    return false;
+#endif
+}
+
+void MMKV::failAppStorageTransaction(int error) {
+    if (isWriteProtectedStorage(m_mmapID) && !m_appStorageTransactionError) {
+        m_appStorageTransactionError = error ? error : EIO;
+    }
+}
+
+bool MMKV::recoverAppStorageTransaction(const string &mmapID, const MMKVConfig &config) {
+    if (!isWriteProtectedStorage(mmapID)) { return true; }
+#ifndef MMKV_WIN32
+    if (config.mode & MMKV_MULTI_PROCESS) { errno = ENOTSUP; return false; }
+#ifdef MMKV_ANDROID
+    if (config.mode & MMKV_ASHMEM) { errno = ENOTSUP; return false; }
+    auto path = mappedKVPathWithID(mmapID, config.rootPath, config.mode, true);
+#else
+    auto path = mappedKVPathWithID(mmapID, config.rootPath, true);
+#endif
+    try { return journalRecover(mmapID, path, config.mode & MMKV_READ_ONLY); }
+    catch (...) { errno = ENOMEM; return false; }
+#else
+    return true;
+#endif
+}
+
+bool MMKV::beginAppStorageTransaction() {
+    if (!isWriteProtectedStorage(m_mmapID)) { return true; }
+    if (m_appStorageTransactionError) { return false; }
+#ifndef MMKV_WIN32
+    if (isReadOnly() || isMultiProcess()) { failAppStorageTransaction(EROFS); return false; }
+    if (m_appStorageTransaction) { return true; }
+    try {
+        int error = m_file->validateMappedPath();
+        if (!error) { error = m_metaFile->validateMappedPath(); }
+        if (error) { failAppStorageTransaction(error); return false; }
+        size_t prefixLength;
+        if (!journalHealthy(m_file->getMemory(), m_file->getFileSize(), m_metaFile->getMemory(), m_metaFile->getFileSize(), prefixLength)) {
+            failAppStorageTransaction(journalError());
+            return false;
+        }
+        const auto pending = m_path + AppStorageJournalSuffix;
+        const auto temporary = pending + ".tmp";
+        bool exists;
+        if (!journalPathExists(pending, exists) || exists) { failAppStorageTransaction(EEXIST); return false; }
+        // An unpublished temporary can only predate canonical mutation. Never follow links.
+        if (!journalPathExists(temporary, exists)) { failAppStorageTransaction(journalError()); return false; }
+        if (exists) {
+            JournalFD stale(journalOpen(temporary, O_RDONLY));
+            struct stat status = {};
+            if (stale.fd < 0 || !journalRegular(stale.fd, status) || unlink(temporary.c_str()) != 0) {
+                failAppStorageTransaction(journalError()); return false;
+            }
+        }
+        JournalFD file(journalOpen(temporary, O_RDWR | O_CREAT | O_EXCL));
+        struct stat fileStatus = {};
+        if (file.fd < 0 || !journalRegular(file.fd, fileStatus) || fchmod(file.fd, 0600) != 0 ||
+            !journalProtect(temporary, m_path, m_crcPath)) { failAppStorageTransaction(journalError()); return false; }
+        JournalFD dataFile(journalOpen(m_path, O_RDONLY)), metaFile(journalOpen(m_crcPath, O_RDONLY));
+        struct stat dataStatus = {}, metaStatus = {};
+        if (dataFile.fd < 0 || metaFile.fd < 0 || !journalRegular(dataFile.fd, dataStatus) || !journalRegular(metaFile.fd, metaStatus)) {
+            failAppStorageTransaction(journalError()); return false;
+        }
+        AppStorageJournalHeader header;
+        header.dataDevice = dataStatus.st_dev; header.dataInode = dataStatus.st_ino;
+        header.metaDevice = metaStatus.st_dev; header.metaInode = metaStatus.st_ino;
+        header.dataFileSize = m_file->getFileSize(); header.metaFileSize = m_metaFile->getFileSize(); header.dataLength = prefixLength;
+        vector<uint8_t> bytes(sizeof(header) + header.metaFileSize + prefixLength);
+        memcpy(bytes.data(), &header, sizeof(header));
+        memcpy(bytes.data() + sizeof(header), m_metaFile->getMemory(), header.metaFileSize);
+        memcpy(bytes.data() + sizeof(header) + header.metaFileSize, m_file->getMemory(), prefixLength);
+        header.checksum = CRC32(0, bytes.data(), bytes.size());
+        memcpy(bytes.data(), &header, sizeof(header));
+        if (!journalTransfer(file.fd, bytes.data(), bytes.size(), true) || !journalSync(file.fd) ||
+            m_file->validateMappedPath() || m_metaFile->validateMappedPath() ||
+            rename(temporary.c_str(), pending.c_str()) != 0 || !journalDirectorySync(m_path)) {
+            failAppStorageTransaction(journalError()); return false;
+        }
+        m_appStorageJournalDevice = fileStatus.st_dev;
+        m_appStorageJournalInode = fileStatus.st_ino;
+        m_appStorageTransaction = true;
+    } catch (...) { failAppStorageTransaction(ENOMEM); return false; }
+#endif
+    return true;
+}
+
+int MMKV::finishAppStorageTransaction() {
+    if (m_appStorageTransactionError) { return m_appStorageTransactionError; }
+#ifndef MMKV_WIN32
+    if (isWriteProtectedStorage(m_mmapID)) {
+        size_t prefixLength;
+        if (!journalHealthy(m_file->getMemory(), m_file->getFileSize(), m_metaFile->getMemory(), m_metaFile->getFileSize(), prefixLength)) {
+            failAppStorageTransaction(journalError());
+            return m_appStorageTransactionError;
+        }
+    }
+    if (m_appStorageTransaction) {
+        struct stat status = {};
+        const auto pending = m_path + AppStorageJournalSuffix;
+        if (lstat(pending.c_str(), &status) != 0 || !S_ISREG(status.st_mode) || status.st_nlink != 1 ||
+            uint64_t(status.st_dev) != m_appStorageJournalDevice || uint64_t(status.st_ino) != m_appStorageJournalInode) {
+            failAppStorageTransaction(ESTALE);
+            return m_appStorageTransactionError;
+        }
+        if (unlink(pending.c_str()) != 0 || !journalDirectorySync(m_path)) {
+            failAppStorageTransaction(journalError());
+            return m_appStorageTransactionError;
+        }
+        m_appStorageTransaction = false;
+    }
+#endif
+    return 0;
+}
