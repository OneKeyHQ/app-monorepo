+bool MMKV::isWriteProtectedStorage(const string &mmapID) {
+    if (mmapID.empty()) { return false; }
+    lock_guard<mutex> guard(writeProtectedStorageMutex());
+    const auto &ids = writeProtectedStorageMap();
+    auto itr = ids.find(mmapID);
+    return itr != ids.end() && itr->second;
