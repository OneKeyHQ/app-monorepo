<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/market_widget_background" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="12dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/market_widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="@color/market_widget_secondary" android:text="OneKey" />
        <ImageView android:id="@+id/market_widget_configure" android:layout_width="36dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/market_widget_edit" android:contentDescription="@string/market_widget_configure" />
        <ImageView android:id="@+id/market_widget_refresh" android:layout_width="36dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/market_widget_refresh" android:contentDescription="@string/market_widget_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/market_widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textSize="13sp" android:textColor="@color/market_widget_secondary" android:text="@string/market_widget_empty" android:visibility="gone" />
    <LinearLayout android:id="@+id/market_widget_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/market_widget_symbol_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/market_widget_foreground" android:text="BTC" />
            <TextView android:id="@+id/market_widget_price_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" android:textSize="15sp" android:textColor="@color/market_widget_foreground" android:text="—" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/market_widget_identity_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/market_widget_secondary" />
            <TextView android:id="@+id/market_widget_change_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textSize="12sp" android:textColor="@color/market_widget_secondary" android:text="—" />
        </LinearLayout>
        <TextView android:id="@+id/market_widget_time_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/market_widget_secondary" android:text="@string/market_widget_unavailable" />
    </LinearLayout>
    <LinearLayout android:id="@+id/market_widget_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/market_widget_symbol_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/market_widget_foreground" android:text="ETH" />
            <TextView android:id="@+id/market_widget_price_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" android:textSize="15sp" android:textColor="@color/market_widget_foreground" android:text="—" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/market_widget_identity_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/market_widget_secondary" />
            <TextView android:id="@+id/market_widget_change_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textSize="12sp" android:textColor="@color/market_widget_secondary" android:text="—" />
        </LinearLayout>
        <TextView android:id="@+id/market_widget_time_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/market_widget_secondary" android:text="@string/market_widget_unavailable" />
    </LinearLayout>
    <LinearLayout android:id="@+id/market_widget_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/market_widget_symbol_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/market_widget_foreground" android:text="SOL" />
            <TextView android:id="@+id/market_widget_price_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" android:textSize="15sp" android:textColor="@color/market_widget_foreground" android:text="—" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/market_widget_identity_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/market_widget_secondary" />
            <TextView android:id="@+id/market_widget_change_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textSize="12sp" android:textColor="@color/market_widget_secondary" android:text="—" />
        </LinearLayout>
        <TextView android:id="@+id/market_widget_time_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="@color/market_widget_secondary" android:text="@string/market_widget_unavailable" />
    </LinearLayout>
    <TextView android:id="@+id/market_widget_currency" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:maxLines="1" android:textSize="10sp" android:textColor="@color/market_widget_secondary" android:text="@string/market_widget_currency" />
</LinearLayout>
