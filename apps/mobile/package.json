{
  "name": "@onekeyhq/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "android": "ENABLE_NATIVE_BACKGROUND_THREAD=true WITH_ROZENITE=true SENTRY_DISABLE_AUTO_UPLOAD=true ANDROID_CHANNEL=direct expo run:android --variant=ProdDebug",
    "android:device": "ENABLE_NATIVE_BACKGROUND_THREAD=true SENTRY_DISABLE_AUTO_UPLOAD=true ANDROID_CHANNEL=direct expo run:android --variant=ProdDebug --device",
    "android:huawei": "ENABLE_NATIVE_BACKGROUND_THREAD=true SENTRY_DISABLE_AUTO_UPLOAD=true ANDROID_CHANNEL=huawei expo run:android --variant=ProdDebug",
    "android:google": "ENABLE_NATIVE_BACKGROUND_THREAD=true SENTRY_DISABLE_AUTO_UPLOAD=true ANDROID_CHANNEL=google expo run:android --variant=GoogleDebug",
    "android:build": "cd android && ENABLE_NATIVE_BACKGROUND_THREAD=true ./gradlew assembleDebug",
    "ios": "ENABLE_NATIVE_BACKGROUND_THREAD=true WITH_ROZENITE=true SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios",
    "ios:device": "ENABLE_NATIVE_BACKGROUND_THREAD=true SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios --device",
    "ios:build": "cd ios && xcodebuild -workspace OneKeyWallet.xcworkspace -scheme OneKeyWallet -configuration Release -archivePath ./build/OneKeyWallet.xcarchive",
    "ios:pod-install": "cd ios && pod install && cd ..",
    "mac_catalyst": "/bin/sh -c \"cd ios && trap 'env -u ONEKEY_MAC_CATALYST pod install' EXIT && pod install && xcodebuild -quiet -workspace OneKeyWallet.xcworkspace -scheme Pods-OneKeyWallet -configuration Debug -destination 'platform=macOS,arch=arm64,variant=Mac Catalyst' -derivedDataPath build/maccatalyst SUPPORTS_MACCATALYST=YES ARCHS=arm64 ONLY_ACTIVE_ARCH=YES && xcodebuild -quiet -workspace OneKeyWallet.xcworkspace -scheme OneKeyWallet -configuration Debug -destination 'platform=macOS,arch=arm64,variant=Mac Catalyst' -derivedDataPath build/maccatalyst SUPPORTS_MACCATALYST=YES ARCHS=arm64 ONLY_ACTIVE_ARCH=YES && open build/maccatalyst/Build/Products/Debug-maccatalyst/OneKeyWallet.app\"",
    "native-bundle": "ENABLE_NATIVE_BACKGROUND_THREAD=true NODE_OPTIONS='--max_old_space_size=8192' WITH_ROZENITE=true react-native start",
    "native-bundle:bg": "ENABLE_NATIVE_BACKGROUND_THREAD=true NODE_OPTIONS='--max_old_space_size=8192' WITH_ROZENITE=true react-native start --port 8082",
    "storybook": "NODE_OPTIONS='--max_old_space_size=8192' STORYBOOK_ENABLED=true expo start",
    "detox:build:ios:sim:debug": "detox build -c ios.sim.debug",
    "detox:test:ios:sim:debug": "detox test -c ios.sim.debug",
    "detox:build:ios:sim:release": "detox build -c ios.sim.release",
    "detox:test:ios:sim:release": "detox test -c ios.sim.release --no-start",
    "detox:build:android:emu:debug": "detox build -c android.emu.debug",
    "detox:test:android:emu:debug": "detox test -c android.emu.debug",
    "detox:build:android:emu:release": "detox build -c android.emu.release",
    "detox:test:android:emu:release": "detox test -c android.emu.release --no-start",
    "harness:test": "HARNESS_PLATFORM=ios RN_HARNESS=true NODE_OPTIONS='--max-old-space-size=16384' npx react-native-harness --config jest.harness.config.mjs --verbose",
    "harness:test:android": "HARNESS_PLATFORM=android RN_HARNESS=true NODE_OPTIONS='--max-old-space-size=8192' npx react-native-harness --config jest.harness.config.mjs --harnessRunner android --verbose",
    "harness:test:lse-mmkv-restart": "HARNESS_PLATFORM=ios RN_HARNESS=true NODE_OPTIONS='--max-old-space-size=16384' npx react-native-harness --config jest.lse-mmkv-restart.harness.config.mjs --verbose",
    "harness:test:lse-mmkv-restart:android": "HARNESS_PLATFORM=android RN_HARNESS=true NODE_OPTIONS='--max-old-space-size=8192' npx react-native-harness --config jest.lse-mmkv-restart.harness.config.mjs --harnessRunner android --verbose",
    "build-bundle": "node build-bundle.js",
    "build-bundle:ios": "node build-ios-bundle.js",
    "build-bundle:android": "node build-android-bundle.js",
    "module-id:update": "node scripts/module-id-registry.js update",
    "module-id:check": "node scripts/module-id-registry.js check",
    "module-id:reconcile": "node scripts/module-id-registry.js reconcile",
    "module-id:resolve-collisions": "node scripts/module-id-registry.js resolve-collisions",
    "dev-vendor:build": "node --expose-gc --max-old-space-size=8192 scripts/build-dev-vendor.js",
    "dev-vendor:check": "node scripts/build-dev-vendor.js --check",
    "dev-vendor:prepare": "node --expose-gc --max-old-space-size=8192 scripts/build-dev-vendor.js --prepare --platform all",
    "dev-vendor:registry:update": "node --expose-gc --max-old-space-size=8192 scripts/build-dev-vendor.js --update-registry --platform all",
    "metro-dev-prebundle:tag": "node scripts/metro-dev-prebundle.js tag",
    "metro-dev-prebundle:package": "node scripts/metro-dev-prebundle.js package",
    "dev-shell": "node scripts/native-dev-shell.js launch",
    "dev-shell:build": "node scripts/build-mobile-dev-shell.js build",
    "dev-shell:contract": "node scripts/native-dev-shell.js contract",
    "dev-shell:restore": "node scripts/mobile-dev-shell-resource.js restore",
    "dev-shell:session": "node scripts/native-dev-shell.js session",
    "clean": "yarn clean:build",
    "clean:build": "rimraf ./dist && rimraf ./expo && rimraf .tamagui && rimraf ./node_modules/.cache && yarn android:clean",
    "android:clean": "./android/gradlew clean -p ./android",
    "android:dependencies": "./android/gradlew dependencies -p ./android",
    "eas-build-pre-install": "git config --global url.\"https://github.com/juicebox-systems/\".insteadOf \"git@github.com:juicebox-systems/\"",
    "eas-build-post-install": "echo $KEY_SECRET | base64 -d > ../../node_modules/@onekeyfe/react-native-lite-card/keys/keys.secret"
  },
