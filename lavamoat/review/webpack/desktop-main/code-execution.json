{
  "description": "动态代码执行、worker、WebAssembly 等执行能力",
  "resources": {
    "@onekeyhq/shared": {
      "globals": {
        "ServiceWorker": true
      }
    },
    "@sentry/electron>@sentry/browser": {
      "globals": {
        "WebAssembly": true
      }
    },
    "@sentry/electron>@sentry/browser>@sentry-internal/replay": {
      "globals": {
        "Worker": true
      }
    },
    "@sentry/electron>@sentry/browser>@sentry-internal/replay-canvas": {
      "globals": {
        "Worker": true
      }
    },
    "@sentry/electron>@sentry/node>@opentelemetry/instrumentation>require-in-the-middle": {
      "builtins": {
        "module._resolveFilename": true,
        "module.builtinModules": true,
        "module.isBuiltin": true,
        "module.prototype.require": true
      }
    },
    "@sentry/electron>@sentry/node>@sentry/node-core": {
      "builtins": {
        "module.register": true
      }
    },
    "@sentry/electron>@sentry/node>@sentry/node-core>@apm-js-collab/tracing-hooks": {
      "builtins": {
        "node:module.prototype._compile": true
      }
    },
    "@sentry/electron>@sentry/node>@sentry/node-core>@apm-js-collab/tracing-hooks>@apm-js-collab/code-transformer": {
      "globals": {
        "WebAssembly.Instance": true,
        "WebAssembly.Module": true
      }
    },
    "@sentry/electron>@sentry/node>import-in-the-middle": {
      "builtins": {
        "module.isBuiltin": true
      }
    }
  }
}
