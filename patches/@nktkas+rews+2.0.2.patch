             }, { signal });
             this._socket.addEventListener("close", (e) => {
                 ac.abort();
-                this.dispatchEvent(new CloseEvent("close", {
-                    code: e.code,
-                    reason: e.reason,
-                    wasClean: e.wasClean,
-                }));
