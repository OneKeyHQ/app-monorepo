+#pragma mark - Navigation transition focus
+
+static const void *RCTDeferredFocusTokenKey = &RCTDeferredFocusTokenKey;
+static const void *RCTReplayingDeferredFocusKey = &RCTReplayingDeferredFocusKey;
+// YES once the keyboard finished appearing and nothing has started moving it since.
+static BOOL RCTKeyboardIsSettledOnScreen = NO;
+
+void RCTBackedTextInputStartObservingKeyboardVisibility(void)
+{
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+    // A nil queue runs the blocks synchronously, so the state is current when UIKit posts and
+    // then immediately restores a first responder within the same call.
+    [center addObserverForName:UIKeyboardDidShowNotification
+                        object:nil
+                         queue:nil
+                    usingBlock:^(__unused NSNotification *notification) {
+                      RCTKeyboardIsSettledOnScreen = YES;
+                    }];
+    for (NSNotificationName name in
+         @[ UIKeyboardWillShowNotification, UIKeyboardWillHideNotification, UIKeyboardDidHideNotification ]) {
+      [center addObserverForName:name
+                          object:nil
+                           queue:nil
+                      usingBlock:^(__unused NSNotification *notification) {
+                        RCTKeyboardIsSettledOnScreen = NO;
+                      }];
+    }
+  });
+}
+
+static void RCTReplayDeferredFocus(UIView *view, id token, BOOL transitionCancelled)
+{
+  // A newer request or a blur replaced the token; drop this one.
+  if (view == nil || objc_getAssociatedObject(view, RCTDeferredFocusTokenKey) != token) {
+    return;
+  }
+  objc_setAssociatedObject(view, RCTDeferredFocusTokenKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+  if (transitionCancelled || view.window == nil) {
+    return;
+  }
+  objc_setAssociatedObject(view, RCTReplayingDeferredFocusKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+  [view becomeFirstResponder];
+  objc_setAssociatedObject(view, RCTReplayingDeferredFocusKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
+BOOL RCTBackedTextInputDeferFocusUntilNavigationTransitionEnds(UIView *backedTextInputView)
+{
+  if (@available(iOS 26.0, *)) {
+  } else {
+    return NO;
+  }
+  // A keyboard that is already on screen is handed over in place and never shows the stand-in.
+  if (RCTKeyboardIsSettledOnScreen || backedTextInputView.isFirstResponder || backedTextInputView.window == nil ||
+      objc_getAssociatedObject(backedTextInputView, RCTReplayingDeferredFocusKey) != nil) {
+    return NO;
+  }
+  id<UIViewControllerTransitionCoordinator> coordinator = backedTextInputView.reactViewController.transitionCoordinator;
+  // Modal presentations keep the live keyboard; only push/pop transitions report UIModalPresentationNone.
+  if (coordinator == nil || coordinator.presentationStyle != UIModalPresentationNone) {
+    return NO;
+  }
+
+  NSObject *token = [NSObject new];
+  objc_setAssociatedObject(backedTextInputView, RCTDeferredFocusTokenKey, token, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+  __weak UIView *weakView = backedTextInputView;
+  BOOL queued = [coordinator animateAlongsideTransition:nil
+                                             completion:^(id<UIViewControllerTransitionCoordinatorContext> context) {
+                                               BOOL cancelled = context.isCancelled;
+                                               // Focus after UIKit has finished the transition, so the keyboard
+                                               // gets its regular show animation after interactive pops too.
+                                               dispatch_async(dispatch_get_main_queue(), ^{
+                                                 RCTReplayDeferredFocus(weakView, token, cancelled);
+                                               });
+                                             }];
+  if (!queued) {
+    objc_setAssociatedObject(backedTextInputView, RCTDeferredFocusTokenKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+  }
+  return queued;
+}
+
+void RCTBackedTextInputCancelDeferredFocus(UIView *backedTextInputView)
+{
+  objc_setAssociatedObject(backedTextInputView, RCTDeferredFocusTokenKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
