+#pragma mark - Navigation transition focus
+
+// OneKey patch: on iOS 26+, a keyboard that appears while a UINavigationController push/pop is running
+// slides in with the screen as a darker stand-in and turns into the real keyboard only when the
+// transition ends. Focus requests made in that window (autoFocus, focus(), UIKit restoring the
+// previous first responder on pop) are postponed until the transition has finished.
+UIKIT_EXTERN void RCTBackedTextInputStartObservingKeyboardVisibility(void);
+// Returns YES when the focus request was postponed; the caller must not become first responder now.
+UIKIT_EXTERN BOOL RCTBackedTextInputDeferFocusUntilNavigationTransitionEnds(UIView *backedTextInputView);
+UIKIT_EXTERN void RCTBackedTextInputCancelDeferredFocus(UIView *backedTextInputView);
+
 NS_ASSUME_NONNULL_END
