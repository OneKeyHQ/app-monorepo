@@ -0,0 +1,38 @@
+// OneKey patch: report actual on-screen content independently of entrance completion.
+import { overlayStore } from '../OverlayStore';
+import { measureContentExtent } from './animateTransition';
+export function observeVisibleContent({ entryId, element, contentRoot, isAnimating, onVisible }) {
+    let frame;
+    let done = false;
+    const schedule = ()=>{
+        if (!done && frame === undefined) frame = requestAnimationFrame(check);
+    };
+    const check = ()=>{
+        frame = undefined;
+        if (done) return;
+        const entry = overlayStore.getEntry(entryId);
+        if (!entry || entry.phase !== 'active') return;
+        if (entry.suspended || entry.scope === 'page' && !overlayStore.isPageHostFocused(entry.hostKey)) return;
+        const extent = measureContentExtent(contentRoot);
+        let visible = element.isConnected && Math.min(extent.right, window.innerWidth) > Math.max(extent.left, 0) && Math.min(extent.bottom, window.innerHeight) > Math.max(extent.top, 0);
+        for(let node = element; visible && node; node = node.parentElement){
+            const style = getComputedStyle(node);
+            visible = style.display !== 'none' && style.visibility !== 'hidden' && style.visibility !== 'collapse' && style.opacity !== '0';
+        }
+        if (visible) {
+            done = true;
+            unsubscribe();
+            onVisible();
+        } else if (isAnimating()) {
+            schedule();
+        }
+    };
+    // Suspended hosts resume after the store updates; wait for their next DOM frame.
+    const unsubscribe = overlayStore.subscribe(schedule);
+    schedule();
+    return ()=>{
+        done = true;
+        if (frame !== undefined) cancelAnimationFrame(frame);
+        unsubscribe();
+    };
+}
