+  let className = NSStringFromClass(type(of: view))
+  print("[TabBarDebug] \(prefix)\(className) frame=\(view.frame) hidden=\(view.isHidden) userInteraction=\(view.isUserInteractionEnabled) alpha=\(view.alpha)")
