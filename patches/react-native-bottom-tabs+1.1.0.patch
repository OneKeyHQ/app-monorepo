+/// Debug helper: swizzle UIWindow.hitTest to log which view receives touches
+class TabBarTouchDebugger {
+  static var isInstalled = false
+
+  static func install() {
+    guard !isInstalled else { return }
+    isInstalled = true
+
+    let originalSelector = #selector(UIView.hitTest(_:with:))
+    let swizzledSelector = #selector(UIWindow.debug_hitTest(_:with:))
+
+    guard let originalMethod = class_getInstanceMethod(UIWindow.self, originalSelector),
+          let swizzledMethod = class_getInstanceMethod(UIWindow.self, swizzledSelector) else {
+      return
+    }
+    method_exchangeImplementations(originalMethod, swizzledMethod)
+    print("[TabBarDebug] Touch debugger installed")
+  }
+}
+
+extension UIWindow {
+  @objc func debug_hitTest(_ point: CGPoint, with event: UIEvent?) -> UIView? {
+    // This calls the original (swizzled) implementation
+    let result = self.debug_hitTest(point, with: event)
+    if let result = result, let event = event, event.type == .touches {
+      let className = NSStringFromClass(type(of: result))
+      // Only log when touch is near the bottom or when result is unexpected
+      if point.y > self.bounds.height - 200 || className.contains("Glass") || className.contains("TabBar") || className.contains("Host") {
+        print("[TabBarDebug] hitTest at \(point) -> \(className) frame=\(result.frame) isUserInteractionEnabled=\(result.isUserInteractionEnabled)")
+      }
+    }
+    return result
+  }
+}
+#endif
