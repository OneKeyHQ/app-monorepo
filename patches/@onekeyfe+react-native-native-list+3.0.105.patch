+
+function jobPriority(job) {
+  let priority = 2;
+  job.ids.forEach((id) => { priority = Math.min(priority, priorities.get(id) ?? 2); });
+  return priority;
+}
+
+function openDatabase() {
+  if (!databasePromise) {
+    databasePromise = new Promise((resolve, reject) => {
+      const request = indexedDB.open(DATABASE, 1);
+      request.onupgradeneeded = () => {
+        const store = request.result.createObjectStore('images', { keyPath: 'uri' });
