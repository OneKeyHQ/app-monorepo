+
+async function drainDiskQueue() {
+  // OneKey patch: a momentary empty load queue is not a scroll-idle window.
+  // if (writing || activeLoads || queue.length) return;
+  if (writing) return;
+  if (!diskIsIdle()) { scheduleDiskWork(); return; }
