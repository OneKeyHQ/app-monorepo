+    val bomb = replaceChunk(png, "IDAT", compressedPixels(1024 * 1024))
+    assertTrue(bomb.size < OneKeyBlockieAvatar.MAX_PNG_BYTES)
+    assertFalse(OneKeyBlockieAvatar.isValidPng(bomb))
