+  @Test
+  fun cancelledBeforeLoadingDoesNotGenerateOrCallBack() {
+    val generated = AtomicInteger()
+    val fetcher = OneKeyBlockieAvatarFetcher(uri, OneKeyAvatarInFlight { _, _ ->
+      generated.incrementAndGet()
+      byteArrayOf(1)
+    })
