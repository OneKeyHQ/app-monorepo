+    guard keyboardType == "decimalPad" else { return text }
+
+    let normalizedSeparators = text
+      .replacingOccurrences(of: "。", with: ".")
+      .replacingOccurrences(of: "，", with: ".")
+      .replacingOccurrences(of: ",", with: ".")
+
+    guard let firstDecimalIndex = normalizedSeparators.firstIndex(of: ".") else {
+      return normalizedSeparators
+    }
+
+    let prefix = normalizedSeparators[...firstDecimalIndex]
+    let suffix = normalizedSeparators[normalizedSeparators.index(after: firstDecimalIndex)...]
+      .replacingOccurrences(of: ".", with: "")
+
+    return String(prefix) + suffix
+  }
