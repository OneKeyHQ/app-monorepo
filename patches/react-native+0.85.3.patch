+// OneKey patch: onPaste payload guard
+BOOL isBlankString(NSString *string)
+{
+  if (!string) {
+    return YES;
+  }
+  if ([string isKindOfClass:[NSNull class]]) {
+    return YES;
+  }
+
+  if (!string.length) {
+    return YES;
+  }
+
+  NSCharacterSet *whitespace = [NSCharacterSet whitespaceAndNewlineCharacterSet];
+  NSString *trimmed = [string stringByTrimmingCharactersInSet:whitespace];
+  if (!trimmed.length) {
+    return YES;
+  }
+
+  return NO;
+}
+
+// OneKey patch: forward native paste to the JS onPaste event
+- (void)textInputDidPaste:(NSString *)type withData:(NSString *)data
+{
+  if (!_onPaste) {
+    return;
+  }
+
+  if (isBlankString(type) || isBlankString(data)) {
+    return;
+  }
+
+  NSMutableArray *items = [NSMutableArray new];
+  [items addObject:@{
+    @"type" : type,
+    @"data" : data,
+  }];
+
+  NSDictionary *payload = @{
+    @"target" : self.reactTag,
+    @"items" : items,
+  };
+
+  _onPaste(payload);
+}
