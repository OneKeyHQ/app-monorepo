+    if (utf8Message) {
+        details.message = std::string(utf8Message);
+    }
+    const char *utf8Domain = [error.domain UTF8String];
+    if (utf8Domain) {
+        details.domain = std::string(utf8Domain);
+    }
+    details.code = static_cast<int>(error.code);
+    return details;
+}
