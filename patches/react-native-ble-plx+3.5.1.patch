+  private void safeWriteCharacteristicWithoutResponseFrame(final Characteristic characteristic,
+                                                           final RxBleConnection connection,
+                                                           final byte[] frame,
+                                                           final int packetSize,
+                                                           final String transactionId,
+                                                           final OnSuccessCallback<Void> onSuccessCallback,
+                                                           final OnErrorCallback onErrorCallback) {
+    final SafeExecutor<Void> safeExecutor = new SafeExecutor<>(onSuccessCallback, onErrorCallback);
+
+    // The long write operation writes batches with the characteristic's current write type.
+    characteristic.setWriteType(BluetoothGattCharacteristic.WRITE_TYPE_NO_RESPONSE);
+
+    // One queued GATT operation for the whole frame. The default ack strategy waits for
+    // onCharacteristicWrite of each batch before writing the next one, so at most one packet is
+    // outstanding. No retry strategy is set on purpose: re-sending a batch after a failure could
+    // duplicate bytes the device already received. Disposing the subscription (cancelTransaction)
+    // stops further batches after the in-flight one is acknowledged.
+    final Disposable subscription = connection
+      .createNewLongWriteBuilder()
+      .setCharacteristic(characteristic.gattCharacteristic)
+      .setBytes(frame)
+      .setMaxBatchSize(packetSize)
+      .build()
+      .doOnDispose(() -> {
+        safeExecutor.error(BleErrorUtils.cancelled());
+        pendingTransactions.removeSubscription(transactionId);
+      })
+      .subscribe(bytes -> {
+        safeExecutor.success(null);
+        pendingTransactions.removeSubscription(transactionId);
+      }, throwable -> {
+        safeExecutor.error(errorConverter.toError(throwable));
+        pendingTransactions.removeSubscription(transactionId);
+      });
+
+    pendingTransactions.replaceSubscription(transactionId, subscription);
+  }
+
