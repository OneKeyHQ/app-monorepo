+    bleError.deviceID = characteristic.getDeviceId();
+    bleError.serviceUUID = UUIDConverter.fromUUID(characteristic.getServiceUUID());
+    bleError.characteristicUUID = UUIDConverter.fromUUID(characteristic.getUuid());
