+// OneKey patch: expose the same native shimmer view to non-React native containers.
+@objc public final class SkeletonNativeView: UIView {
+  private var skeleton: HybridSkeleton?
+  private var configuredSpeed: Double = 3
+  private var configuredGradientColors: [String]?
+
+  @objc public override init(frame: CGRect) {
+    super.init(frame: frame)
+    isUserInteractionEnabled = false
+    accessibilityElementsHidden = true
+    clipsToBounds = true
+    attachSkeleton()
+  }
+
+  required init?(coder: NSCoder) {
+    super.init(coder: coder)
+    isUserInteractionEnabled = false
+    accessibilityElementsHidden = true
+    clipsToBounds = true
+    attachSkeleton()
+  }
+
+  @objc public func configure(
+    shimmerSpeed: Double,
+    shimmerGradientColors: [String]
+  ) {
+    configuredSpeed = shimmerSpeed
+    configuredGradientColors = shimmerGradientColors
+    skeleton?.shimmerSpeed = shimmerSpeed
+    skeleton?.shimmerGradientColors = shimmerGradientColors
+  }
+
+  public override func layoutSubviews() {
+    super.layoutSubviews()
+    skeleton?.view.frame = bounds
+    skeleton?.afterUpdate()
+  }
+
+  private func attachSkeleton() {
+    let nextSkeleton = HybridSkeleton()
+    nextSkeleton.shimmerSpeed = configuredSpeed
+    nextSkeleton.shimmerGradientColors = configuredGradientColors
+    nextSkeleton.view.frame = bounds
+    addSubview(nextSkeleton.view)
+    skeleton = nextSkeleton
+  }
+}
