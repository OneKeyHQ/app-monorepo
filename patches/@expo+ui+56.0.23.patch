+// OneKey patch: expose SwiftUI's preferredColorScheme. Unlike the environment
+// colorScheme (subtree-only), it flows up to the enclosing presentation and
+// flips the system sheet chrome - background material, grabber - to the given
+// scheme. This is the only lever that keeps the native glass material while
+// pinning a sheet dark on a light system.
+
+// MARK: - Preferred Color Scheme
+
+internal struct PreferredColorSchemeModifier: ViewModifier, Record {
+  @Field var colorScheme: ColorSchemeType = .light
+
+  func body(content: Content) -> some View {
+    content.preferredColorScheme(colorScheme.toNativeColorScheme())
+  }
+}
