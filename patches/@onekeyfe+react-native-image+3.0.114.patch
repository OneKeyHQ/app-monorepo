+package com.margelo.nitro.onekeyimage
+
+import android.os.SystemClock
+import android.view.View
+import android.widget.TextView
+import com.margelo.nitro.nativelogger.OneKeyLog
+import org.json.JSONObject
+import java.util.concurrent.atomic.AtomicLong
+
+/** Temporary physical-device diagnostics; never records source URLs or account values. */
+object OneKeyFlickerTrace {
+  private val sequence = AtomicLong()
+
+  fun event(view: View, event: String, vararg fields: Pair<String, Any?>) {
+    if (!BuildConfig.DEBUG) return
+    val payload = JSONObject()
+      .put("seq", sequence.incrementAndGet())
+      .put("epochMs", System.currentTimeMillis())
+      .put("uptimeMs", SystemClock.uptimeMillis())
+      .put("event", event)
+      .put("view", System.identityHashCode(view))
+      .put("reactTag", view.id)
+      .put("class", view.javaClass.simpleName)
+      .put("ancestors", generateSequence(view.parent as? View) { it.parent as? View }
+        .take(8).joinToString(">") { "${it.javaClass.simpleName}:${System.identityHashCode(it)}" })
+      .put("parent", view.parent?.let(System::identityHashCode) ?: 0)
+      .put("attached", view.isAttachedToWindow)
+      .put("shown", view.isShown)
+      .put("alpha", view.alpha)
+      .put("width", view.width)
+      .put("height", view.height)
+      .put("nightMode", view.resources.configuration.uiMode and 0x30)
+    fields.forEach { (key, value) -> payload.put(key, value ?: JSONObject.NULL) }
+    val message = "[NATIVE-FLICKER] $payload"
+    OneKeyLog.info("NativeFlicker", message)
+    android.util.Log.i("NativeFlicker", message)
+  }
+
+  fun label(view: TextView, event: String, row: View) {
+    if (!BuildConfig.DEBUG) return
+    val layout = view.layout
+    event(view, event,
+      "row" to System.identityHashCode(row),
+      "textLength" to view.text.length,
+      "placeholder" to (view.text.toString() == "--"),
+      "desiredWidth" to android.text.Layout.getDesiredWidth(view.text, view.paint),
+      "measuredWidth" to view.measuredWidth,
+      "paramWidth" to view.layoutParams?.width,
+      "layoutWidth" to layout?.width,
+      "ellipsis" to (if (layout != null && layout.lineCount > 0) layout.getEllipsisCount(0) else 0),
+      "layoutRequested" to view.isLayoutRequested,
+      "parentLayoutRequested" to (view.parent as? View)?.isLayoutRequested)
+  }
+}
