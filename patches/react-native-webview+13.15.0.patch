+static NSString *OKNormalizeHostname(NSString *hostname) {
+  NSString *normalizedHostname = [[hostname ?: @"" stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] lowercaseString];
+  while ([normalizedHostname hasSuffix:@"."]) {
+    normalizedHostname = [normalizedHostname substringToIndex:normalizedHostname.length - 1];
+  }
+  return normalizedHostname;
+}
+
+static BOOL OKIsIPHostname(NSString *hostname) {
+  if ([hostname containsString:@":"]) {
+    return YES;
+  }
+
+  NSArray<NSString *> *segments = [hostname componentsSeparatedByString:@"."];
+  if (segments.count != 4) {
+    return NO;
+  }
+
+  NSCharacterSet *nonDigits = [[NSCharacterSet decimalDigitCharacterSet] invertedSet];
+  for (NSString *segment in segments) {
+    if (segment.length == 0 || [segment rangeOfCharacterFromSet:nonDigits].location != NSNotFound) {
+      return NO;
+    }
+  }
+
+  return YES;
+}
+
+static NSString *OKHostnameDomainKey(NSString *hostname) {
+  NSString *normalizedHostname = OKNormalizeHostname(hostname);
+  if (normalizedHostname.length == 0) {
+    return nil;
+  }
+  if (OKIsIPHostname(normalizedHostname)) {
+    return normalizedHostname;
+  }
+
+  NSArray<NSString *> *labels = [normalizedHostname componentsSeparatedByString:@"."];
+  if (labels.count <= 2) {
+    return normalizedHostname;
+  }
+
+  NSString *topLevelLabel = labels.lastObject;
+  NSString *secondLevelLabel = labels[labels.count - 2];
+  if (topLevelLabel.length == 2 && secondLevelLabel.length <= 3 && labels.count >= 3) {
+    return [NSString stringWithFormat:@"%@.%@.%@", labels[labels.count - 3], secondLevelLabel, topLevelLabel];
+  }
+
+  return [NSString stringWithFormat:@"%@.%@", secondLevelLabel, topLevelLabel];
+}
+
+static NSString *OKOriginDomainKey(NSString *scheme, NSString *host) {
+  NSString *normalizedScheme = [scheme.lowercaseString copy];
+  if (![normalizedScheme isEqualToString:@"https"] && ![normalizedScheme isEqualToString:@"http"]) {
+    return nil;
+  }
+
+  NSString *domainKey = OKHostnameDomainKey(host);
+  if (domainKey.length == 0) {
+    return nil;
+  }
+
+  return [NSString stringWithFormat:@"%@://%@", normalizedScheme, domainKey];
+}
+
+static NSSet<NSString *> *OKBuildWhitelistDomainKeys(NSSet<NSString *> *whitelist) {
+  if (whitelist.count == 0) {
+    return nil;
+  }
+
+  NSMutableSet<NSString *> *domainKeys = [NSMutableSet set];
+  for (NSString *whitelistedOrigin in whitelist) {
+    NSURLComponents *components = [NSURLComponents componentsWithString:whitelistedOrigin];
+    NSString *whitelistedDomainKey = OKOriginDomainKey(components.scheme, components.host);
+    if (whitelistedDomainKey.length > 0) {
+      [domainKeys addObject:whitelistedDomainKey];
+    }
+  }
+
