+  // OneKey patch: expose Skia's locale-aware system fallback lookup.
+  std::variant<std::nullptr_t, std::shared_ptr<JsiSkTypeface>>
+  matchFamilyStyleCharacter(std::string name,
+                            std::shared_ptr<SkFontStyle> fontStyle,
+                            std::vector<std::string> bcp47Strings,
+                            double character) {
+    auto resolvedName = getContext()->resolveFontFamily(name);
+    std::vector<const char *> bcp47;
+    bcp47.reserve(bcp47Strings.size());
+    for (const auto &locale : bcp47Strings) {
+      bcp47.push_back(locale.c_str());
+    }
+    auto typeface = getObject()->matchFamilyStyleCharacter(
+        resolvedName.c_str(), *fontStyle, bcp47.data(),
+        static_cast<int>(bcp47.size()), static_cast<SkUnichar>(character));
+    if (!typeface) {
+      return nullptr;
+    }
+    return std::make_shared<JsiSkTypeface>(getContext(), std::move(typeface));
+  }
