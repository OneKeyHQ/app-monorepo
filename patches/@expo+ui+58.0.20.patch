   }
 
+  // OneKey patch: SwiftUI evaluates sheet content through transient copies of
+  // this host while the sheet presents. The copy that created the touch
+  // handler can disappear right after a surviving copy appeared (which found
+  // the handler already attached and owns nothing), so an eager detach here
+  // strips the only RCTSurfaceTouchHandler off the hosted RN tree and every
+  // Pressable inside the sheet goes dead. Release ownership immediately but
+  // only remove the recognizer once the view has really left its SwiftUI
+  // host; a view that is still hosted keeps it.
   func detach() {
-    if let touchHandler, let attachedView {
-      ExpoUITouchHandlerHelper.detachTouchHandler(touchHandler, from: attachedView)
+    guard let handler = touchHandler, let view = attachedView else {
+      touchHandler = nil
+      attachedView = nil
+      return
+    }
+    touchHandler = nil
+    attachedView = nil
+    Self.detachWhenUnhosted(handler, from: view)
+  }
+
+  private func detachNow() {
+    if let handler = touchHandler, let view = attachedView {
+      ExpoUITouchHandlerHelper.detachTouchHandler(handler, from: view)
     }
     touchHandler = nil
     attachedView = nil
   }
 
+  private static func isSwiftUIHosted(_ view: UIView) -> Bool {
+    var current = view.superview
+    var depth = 0
+    while let candidate = current, depth < 60 {
+      if NSStringFromClass(type(of: candidate)).contains("HostingView") {
+        return true
+      }
+      current = candidate.superview
+      depth += 1
+    }
+    return false
+  }
+
+  private static func detachWhenUnhosted(_ handler: UIGestureRecognizer, from view: UIView) {
+    DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) {
+      if view.superview != nil, isSwiftUIHosted(view) {
+        detachWhenUnhosted(handler, from: view)
+        return
+      }
+      ExpoUITouchHandlerHelper.detachTouchHandler(handler, from: view)
+    }
+  }
+
   deinit {
     detach()
   }
