+package com.sniconnect
+
+import java.util.Collections
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class SniConnectRequestAdmissionTest {
+  @Test
+  fun snapshotReturnsOnlyNonEmptyIdsForTargetPair() {
+    val admission = admission(maxActive = 2, maxPerPair = 1)
+    try {
+      val activeTarget = ticket(
+        admission,
+        "example.com",
+        "93.184.216.34",
+        requestId = "active-target",
+      ).also { it.submit() }
+      val activeOther = ticket(
+        admission,
+        "example.com",
+        "93.184.216.35",
+        requestId = "active-other",
+      ).also { it.submit() }
+      val pendingTarget = ticket(
+        admission,
+        "example.com",
+        "93.184.216.34",
+        requestId = "pending-target",
+      ).also { it.submit() }
+      val pendingWithoutId = ticket(
+        admission,
+        "example.com",
+        "93.184.216.34",
+        requestId = "",
+      ).also { it.submit() }
+
+      assertEquals(
+        SniConnectAdmissionSnapshot(
+          activeRequests = 2,
+          activeRequestsForPair = 1,
+          pendingRequests = 2,
+          pendingRequestsForPair = 2,
+          activeRequestIdsForPair = listOf("active-target"),
+          pendingRequestIdsForPair = listOf("pending-target"),
+        ),
+        admission.snapshot("EXAMPLE.COM", "093.184.216.034"),
+      )
+
+      assertTrue(pendingTarget.cancelPending())
+      assertTrue(pendingWithoutId.cancelPending())
+      activeTarget.release()
+      activeOther.release()
+    } finally {
+      admission.shutdownForTests()
+    }
+  }
+
+  @Test
+  fun equivalentIpTextSharesPairLimitAndSnapshot() {
+    val admission = admission(maxActive = 2, maxPerPair = 1)
+    val admitted = mutableListOf<String>()
+    try {
+      val first = submit(
+        admission,
+        "first",
+        "Example.com",
+        "093.184.216.034",
+        admitted,
+      )
+      val second = submit(
+        admission,
+        "second",
+        "example.com",
+        "93.184.216.34",
+        admitted,
+      )
+
+      assertEquals(listOf("first"), admitted)
+      assertEquals(
+        SniConnectAdmissionSnapshot(1, 1, 1, 1),
+        admission.snapshot("EXAMPLE.COM", "093.184.216.034"),
+      )
+      assertEquals(
+        SniConnectAdmissionSnapshot(1, 1, 1, 1),
+        admission.snapshot("example.com", "93.184.216.34"),
+      )
+
+      first.release()
+      assertEquals(listOf("first", "second"), admitted)
+      second.release()
+    } finally {
+      admission.shutdownForTests()
+    }
+  }
+
+  @Test
+  fun sameHostnameDifferentIpsHaveIndependentPairLimits() {
+    val admission = admission(maxActive = 4, maxPerPair = 2)
+    val admitted = Collections.synchronizedList(mutableListOf<String>())
+    try {
+      val firstA = submit(admission, "a1", "Example.com", "93.184.216.34", admitted)
+      val secondA = submit(admission, "a2", "example.com", "93.184.216.34", admitted)
+      val pendingA = submit(admission, "a3", "example.com", "93.184.216.34", admitted)
+      val firstB = submit(admission, "b1", "example.com", "93.184.216.35", admitted)
+      val secondB = submit(admission, "b2", "example.com", "93.184.216.35", admitted)
+
+      assertEquals(listOf("a1", "a2", "b1", "b2"), admitted.toList())
+      assertEquals(
+        SniConnectAdmissionSnapshot(4, 2, 1, 1),
+        admission.snapshot("EXAMPLE.COM", "93.184.216.34"),
+      )
+      assertEquals(
+        SniConnectAdmissionSnapshot(4, 2, 1, 0),
+        admission.snapshot("example.com", "93.184.216.35"),
+      )
+
+      firstA.release()
+      assertEquals(listOf("a1", "a2", "b1", "b2", "a3"), admitted.toList())
+      assertEquals(
+        SniConnectAdmissionSnapshot(4, 2, 0, 0),
+        admission.snapshot("example.com", "93.184.216.34"),
+      )
+
+      secondA.release()
+      pendingA.release()
+      firstB.release()
+      secondB.release()
+      assertEquals(
+        SniConnectAdmissionSnapshot(0, 0, 0, 0),
+        admission.snapshot("example.com", "93.184.216.34"),
+      )
+    } finally {
+      admission.shutdownForTests()
+    }
+  }
+
+  @Test
+  fun cancellingPendingRequestRemovesItAndSettlesImmediately() {
+    val admission = admission(maxActive = 1, maxPerPair = 1)
+    val failures = mutableListOf<Pair<String, String>>()
+    try {
+      val active = ticket(admission, "example.com", "93.184.216.34")
+      active.submit()
+      val pending = admission.createTicket(
+        hostname = "example.com",
+        ip = "93.184.216.34",
+        timeoutMillis = 10_000,
+        onAdmitted = { throw AssertionError("Cancelled request must not be admitted") },
+        onPendingFailure = { code, message -> failures += code to message },
+      )
+      pending.submit()
+
+      assertEquals(1, admission.snapshot("example.com", "93.184.216.34").pendingRequests)
+      assertTrue(pending.cancelPending())
+      assertEquals(listOf("SNI_CANCELLED" to "Request cancelled"), failures)
+      assertEquals(0, admission.snapshot("example.com", "93.184.216.34").pendingRequests)
+      assertFalse(pending.cancelPending())
+
+      active.release()
+    } finally {
+      admission.shutdownForTests()
+    }
+  }
+
+  @Test
+  fun timeoutIncludesTimeSpentWaitingForAdmission() {
+    val admission = admission(maxActive = 1, maxPerPair = 1)
+    val timedOut = CountDownLatch(1)
+    val failureCodes = Collections.synchronizedList(mutableListOf<String>())
+    try {
+      val active = ticket(admission, "example.com", "93.184.216.34")
+      active.submit()
+      val pending = admission.createTicket(
+        hostname = "example.com",
+        ip = "93.184.216.34",
+        timeoutMillis = 40,
+        onAdmitted = { throw AssertionError("Timed-out request must not be admitted") },
+        onPendingFailure = { code, _ ->
+          failureCodes += code
+          timedOut.countDown()
+        },
+      )
+      pending.submit()
+
+      assertTrue(timedOut.await(2, TimeUnit.SECONDS))
+      assertEquals(listOf("SNI_REQUEST_TIMEOUT"), failureCodes.toList())
+      assertEquals(
+        SniConnectAdmissionSnapshot(1, 1, 0, 0),
+        admission.snapshot("example.com", "93.184.216.34"),
+      )
+
+      active.release()
+    } finally {
+      admission.shutdownForTests()
+    }
+  }
+
+  @Test
+  fun overflowAndCancellationLeaveNoAdmissionStateBehind() {
+    val admission = admission(maxActive = 1, maxPerPair = 1, maxPending = 2)
+    val admitted = Collections.synchronizedList(mutableListOf<String>())
+    try {
+      val active = submit(admission, "active", "example.com", "93.184.216.34", admitted)
+      val firstPending = submit(admission, "pending-1", "example.com", "93.184.216.34", admitted)
+      val secondPending = submit(admission, "pending-2", "example.com", "93.184.216.34", admitted)
+      val overflow = ticket(admission, "example.com", "93.184.216.34")
+
+      assertValidationFails { overflow.submit() }
+      assertEquals(
+        SniConnectAdmissionSnapshot(1, 1, 2, 2),
+        admission.snapshot("example.com", "93.184.216.34"),
+      )
+
+      assertTrue(firstPending.cancelPending())
+      active.release()
+      assertEquals(listOf("active", "pending-2"), admitted.toList())
+      secondPending.release()
+      assertEquals(
+        SniConnectAdmissionSnapshot(0, 0, 0, 0),
+        admission.snapshot("example.com", "93.184.216.34"),
+      )
+    } finally {
+      admission.shutdownForTests()
+    }
+  }
+
+  private fun admission(
+    maxActive: Int,
+    maxPerPair: Int,
+    maxPending: Int = 10,
+  ) = SniConnectRequestAdmission(
+    maxActiveRequests = maxActive,
+    maxActiveRequestsPerPair = maxPerPair,
+    maxPendingRequests = maxPending,
+  )
+
+  private fun submit(
+    admission: SniConnectRequestAdmission,
+    id: String,
+    hostname: String,
+    ip: String,
+    admitted: MutableList<String>,
+  ): SniConnectRequestAdmission.Ticket =
+    ticket(admission, hostname, ip, onAdmitted = { admitted += id }).also { it.submit() }
+
+  private fun ticket(
+    admission: SniConnectRequestAdmission,
+    hostname: String,
+    ip: String,
+    onAdmitted: (Long) -> Unit = {},
+    requestId: String? = null,
+  ): SniConnectRequestAdmission.Ticket = admission.createTicket(
+    hostname = hostname,
+    ip = ip,
+    requestId = requestId,
+    timeoutMillis = 10_000,
+    onAdmitted = onAdmitted,
+    onPendingFailure = { _, _ -> },
+  )
+
+  private fun assertValidationFails(block: () -> Unit) {
+    try {
+      block()
+    } catch (_: SniConnectValidation.ValidationException) {
+      return
+    }
+    throw AssertionError("Expected SNI validation failure")
+  }
+}
