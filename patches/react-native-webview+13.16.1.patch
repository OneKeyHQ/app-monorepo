+- (NSData *)readComponents:(NSArray<NSString *> *)components {
+  if (_rootFD < 0) return nil;
+  int current = dup(_rootFD);
+  if (current < 0) return nil;
+  for (NSUInteger index = 0; index < components.count; index++) {
+    BOOL last = index == components.count - 1;
+    int next = openat(current, components[index].fileSystemRepresentation,
+                      O_RDONLY | O_NOFOLLOW | O_CLOEXEC | (last ? 0 : O_DIRECTORY));
+    close(current);
+    current = next;
+    if (current < 0) return nil;
+  }
+  struct stat attributes;
+  if (fstat(current, &attributes) != 0 || !S_ISREG(attributes.st_mode)) {
+    close(current);
+    return nil;
+  }
+  NSMutableData *data = [NSMutableData data];
+  uint8_t buffer[65536];
+  ssize_t count;
+  while ((count = read(current, buffer, sizeof(buffer))) > 0) {
+    [data appendBytes:buffer length:(NSUInteger)count];
+  }
+  close(current);
+  return count == 0 ? data : nil;
+}
