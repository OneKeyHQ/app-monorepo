+- (void)webView:(WKWebView *)webView startURLSchemeTask:(id<WKURLSchemeTask>)task {
+  NSAssert([NSThread isMainThread], @"WebEmbed task state is main-thread only");
+  if (_invalidated) {
+    [task didFailWithError:[NSError errorWithDomain:NSURLErrorDomain code:NSURLErrorCancelled userInfo:nil]];
+    return;
+  }
+  NSObject *token = [NSObject new];
+  [_tasks setObject:token forKey:task];
+  NSURLRequest *request = task.request;
+  NSArray<NSString *> *components = [RNCOneKeyWebEmbedAssets pathComponentsForRequest:request];
