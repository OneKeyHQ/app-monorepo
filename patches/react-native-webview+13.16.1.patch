+// OneKey patch: no network proxy, CORS relaxation, private WebKit API, or mutable root.
+#import "RNCOneKeyWebEmbedAssets.h"
+#import <fcntl.h>
+#import <sys/stat.h>
+#import <unistd.h>
+
+static NSString *const OKWebEmbedScheme = @"onekey-web-embed";
+static NSString *const OKWebEmbedHost = @"bundle";
+
+@implementation RNCOneKeyWebEmbedAssets {
+  int _rootFD;
+  BOOL _invalidated;
+  NSMapTable<id<WKURLSchemeTask>, NSObject *> *_tasks;
+  dispatch_queue_t _readQueue;
+}
+
++ (NSURL *)documentURL {
+  return [NSURL URLWithString:@"onekey-web-embed://bundle/index.html"];
+}
+
++ (BOOL)hasAllowedAuthority:(NSURLComponents *)parts {
+  return parts && [parts.string hasPrefix:@"onekey-web-embed://bundle/"] &&
+    [parts.percentEncodedHost isEqualToString:OKWebEmbedHost] && [parts.scheme isEqualToString:OKWebEmbedScheme] &&
+    [parts.host isEqualToString:OKWebEmbedHost] && !parts.user &&
+    !parts.password && !parts.port && !parts.query;
+}
+
++ (BOOL)isDocumentURL:(NSURL *)url allowFragment:(BOOL)allowFragment {
+  if (!url) return NO;
+  NSString *canonical = self.documentURL.absoluteString;
+  if (![url.absoluteString isEqualToString:canonical] &&
+      !(allowFragment && [url.absoluteString hasPrefix:[canonical stringByAppendingString:@"#"]])) return NO;
+  NSURLComponents *parts = [NSURLComponents componentsWithURL:url resolvingAgainstBaseURL:NO];
+  return [self hasAllowedAuthority:parts] &&
+    [parts.percentEncodedPath isEqualToString:@"/index.html"] &&
+    (allowFragment || !parts.fragment);
+}
+
++ (BOOL)isAllowedSource:(NSDictionary *)source {
+  if (![source isKindOfClass:[NSDictionary class]] || ![source[@"uri"] isKindOfClass:[NSString class]]) return NO;
+  for (NSString *key in source) {
+    if (![key isEqualToString:@"uri"] && ![key isEqualToString:@"method"]) return NO;
+  }
+  if (![source[@"uri"] isEqualToString:self.documentURL.absoluteString]) return NO;
+  return (!source[@"method"] || [source[@"method"] isEqual:@"GET"]) &&
+    [self isDocumentURL:[NSURL URLWithString:source[@"uri"]] allowFragment:NO];
+}
