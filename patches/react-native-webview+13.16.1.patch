+package com.reactnativecommunity.webview;
+
+import android.content.Context;
+import android.net.Uri;
+import android.webkit.WebResourceResponse;
+
+import androidx.annotation.Nullable;
+import androidx.webkit.WebViewAssetLoader;
+
+import java.io.ByteArrayInputStream;
+import java.util.Collections;
+
+/** OneKey patch: no filesystem mounts, configurable roots, or reserved-origin network fallback. */
+public final class OneKeyWebEmbedAssetLoader {
+    private final WebViewAssetLoader loader;
+    private final boolean secureBridgeSupported;
+
+    public OneKeyWebEmbedAssetLoader(Context context, boolean secureBridgeSupported) {
+        this.secureBridgeSupported = secureBridgeSupported;
+        WebViewAssetLoader.AssetsPathHandler assets =
+                new WebViewAssetLoader.AssetsPathHandler(context.getApplicationContext());
+        loader = new WebViewAssetLoader.Builder()
+                .addPathHandler("/web-embed/", suffix -> {
+                    String path = OneKeyWebEmbedUrlPolicy.getAssetPath(
+                            OneKeyWebEmbedUrlPolicy.ORIGIN + "/web-embed/" + suffix);
+                    if (path == null) return denied();
+                    WebResourceResponse response = assets.handle(path);
+                    if (response == null || response.getData() == null) return denied();
+                    if (path.endsWith(".wasm")) response.setMimeType("application/wasm");
+                    if (path.endsWith(".bin")) response.setMimeType("application/octet-stream");
+                    // Each APK supplies its own index and immutable hashed assets.
+                    response.setResponseHeaders(Collections.singletonMap("Cache-Control", "no-store"));
+                    return response;
+                })
+                .build();
+    }
+
+    public boolean canLoadDocument(String url) {
+        return secureBridgeSupported && OneKeyWebEmbedUrlPolicy.isDocumentUrl(url);
+    }
+
+    public boolean canReceiveMessage(String origin, boolean isMainFrame) {
+        return secureBridgeSupported && OneKeyWebEmbedUrlPolicy.isBridgeMessageAllowed(origin, isMainFrame);
+    }
+
+    private static WebResourceResponse denied() {
+        return new WebResourceResponse("text/plain", "UTF-8", 404, "Not Found",
+                Collections.singletonMap("Cache-Control", "no-store"),
+                new ByteArrayInputStream(new byte[0]));
+    }
+
+    public @Nullable WebResourceResponse intercept(String url, String method, boolean isMainFrame) {
+        if (!secureBridgeSupported || (isMainFrame && !canLoadDocument(url))) return denied();
+        if (OneKeyWebEmbedUrlPolicy.isReservedHost(url)) {
+            if (!"GET".equals(method) || OneKeyWebEmbedUrlPolicy.getAssetPath(url) == null) {
+                return denied();
+            }
+            WebResourceResponse response = loader.shouldInterceptRequest(Uri.parse(url));
+            return response == null ? denied() : response;
+        }
+        if (OneKeyWebEmbedUrlPolicy.isLocalFile(url)) return denied();
+        // Unrelated HTTPS subresources retain the existing WebView/CSP/policy checks.
+        return null;
+    }
+}
