+package com.reactnativecommunity.webview;
+
+import java.net.URI;
+import java.net.URISyntaxException;
+
+/** OneKey patch: this origin only represents the immutable APK WebEmbed directory. */
+public final class OneKeyWebEmbedUrlPolicy {
+    public static final String DOMAIN = "appassets.androidplatform.net";
+    public static final String ORIGIN = "https://" + DOMAIN;
+    public static final String DOCUMENT_URL = ORIGIN + "/web-embed/index.html";
+    private static final String PATH_PREFIX = "/web-embed/";
+
+    private OneKeyWebEmbedUrlPolicy() {}
+
+    private static URI parse(String value) {
+        if (value == null) return null;
+        try {
+            return new URI(value);
+        } catch (URISyntaxException exception) {
+            return null;
+        }
+    }
+
+    public static boolean isReservedHost(String value) {
+        if (value == null) return false;
+        int separator = value.indexOf("://");
+        if (separator < 0) return false;
+        String authority = value.substring(separator + 3).split("[/\\\\?#]", 2)[0];
+        // Encoded authorities are never needed by the fixed APK URL. Treat them
+        // as blocked candidates instead of letting Android normalize a fallback.
+        if (authority.indexOf('%') >= 0) return true;
+        String host = authority.substring(authority.lastIndexOf('@') + 1).split(":", 2)[0];
+        while (host.endsWith(".")) host = host.substring(0, host.length() - 1);
+        return DOMAIN.equalsIgnoreCase(host);
+    }
+
+    public static boolean isLocalFile(String value) {
+        if (value == null) return false;
+        int separator = value.indexOf(':');
+        String scheme = separator < 0 ? "" : value.substring(0, separator);
+        return "file".equalsIgnoreCase(scheme) || "content".equalsIgnoreCase(scheme);
+    }
+
+    public static String getAssetPath(String value) {
+        URI uri = parse(value);
+        if (uri == null || !"https".equals(uri.getScheme())
+                || !DOMAIN.equals(uri.getRawAuthority()) || uri.getRawQuery() != null) {
+            return null;
+        }
+        String path = uri.getRawPath();
+        if (path == null || !path.startsWith(PATH_PREFIX)) return null;
+        String suffix = path.substring(PATH_PREFIX.length());
+        // Reject escaped separators/dot segments before Android Uri decodes the path.
+        if (!suffix.matches("[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*")) return null;
+        for (String segment : suffix.split("/")) {
+            if (".".equals(segment) || "..".equals(segment)) return null;
+        }
+        return "web-embed/" + suffix;
+    }
+
+    public static boolean isDocumentUrl(String value) {
+        return "web-embed/index.html".equals(getAssetPath(value));
+    }
+
+    public static boolean isBridgeMessageAllowed(String origin, boolean isMainFrame) {
+        return isMainFrame && ORIGIN.equals(origin);
+    }
+}
