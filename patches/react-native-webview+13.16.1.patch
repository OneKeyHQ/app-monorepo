+// OneKey patch: grant media capture only to the exact requesting origin.
+static NSString *OKCanonicalMediaPermissionOrigin(NSString *scheme, NSString *host, NSInteger port) {
+  if (scheme.length == 0 || host.length == 0 || port < 0 || port > 65535) {
+    return nil;
+  }
+  NSString *normalizedScheme = scheme.lowercaseString;
+  if (![normalizedScheme isEqualToString:@"https"] && ![normalizedScheme isEqualToString:@"http"]) {
+    return nil;
+  }
+  NSString *normalizedHost = host.lowercaseString;
+  if ([normalizedHost containsString:@":"] && ![normalizedHost hasPrefix:@"["]) {
+    normalizedHost = [NSString stringWithFormat:@"[%@]", normalizedHost];
+  }
+  NSInteger effectivePort = port == 0 ? ([normalizedScheme isEqualToString:@"https"] ? 443 : 80) : port;
+  return [NSString stringWithFormat:@"%@://%@:%ld", normalizedScheme, normalizedHost, (long)effectivePort];
+}
+
+static NSString *OKCanonicalWhitelistedMediaOrigin(NSString *origin) {
+  if (![origin isKindOfClass:[NSString class]]) {
+    return nil;
+  }
+  NSURLComponents *components = [NSURLComponents componentsWithString:origin];
+  NSString *path = components.percentEncodedPath;
+  NSRange schemeSeparator = [origin rangeOfString:@"://"];
+  if (schemeSeparator.location == NSNotFound || components.host.length == 0
+      || components.user != nil || components.password != nil
+      || components.query != nil || components.fragment != nil
+      || (path.length > 0 && ![path isEqualToString:@"/"])) {
+    return nil;
+  }
+  NSString *authorityAndPath = [origin substringFromIndex:NSMaxRange(schemeSeparator)];
+  NSRange authorityEnd = [authorityAndPath rangeOfCharacterFromSet:[NSCharacterSet characterSetWithCharactersInString:@"/?#"]];
+  NSString *authority = authorityEnd.location == NSNotFound
+      ? authorityAndPath : [authorityAndPath substringToIndex:authorityEnd.location];
+  if ([authority hasSuffix:@":"]) {
+    return nil;
+  }
+  NSNumber *port = components.port;
+  if (port != nil && (port.integerValue <= 0 || port.integerValue > 65535)) {
+    return nil;
+  }
+  return OKCanonicalMediaPermissionOrigin(components.scheme, components.host, port ? port.integerValue : 0);
+}
