+      ![request.HTTPMethod isEqualToString:@"GET"] || ![path hasPrefix:@"/"]) return nil;
+  NSCharacterSet *allowed = [NSCharacterSet characterSetWithCharactersInString:@"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._/"];
+  if ([path rangeOfCharacterFromSet:allowed.invertedSet].location != NSNotFound) return nil;
+  NSArray<NSString *> *components = [[path substringFromIndex:1] componentsSeparatedByString:@"/"];
