+- (void)endRefreshingProgrammatically
+{
+  UIScrollView *scrollView = _scrollViewComponentView.scrollView;
+  CGFloat previousTopInset = scrollView.adjustedContentInset.top;
+  [_refreshControl endRefreshing];
+
+  // UIKit can remove the refresh inset without restoring a partially collapsed offset.
+  // Leave active gestures and the normal fully expanded refresh animation to UIKit.
+  CGPoint offset = scrollView.contentOffset;
+  CGFloat topOffset = -scrollView.adjustedContentInset.top;
+  if (scrollView && !scrollView.dragging && !scrollView.decelerating && offset.y > -previousTopInset &&
+      offset.y < topOffset) {
+    [scrollView setContentOffset:CGPointMake(offset.x, topOffset) animated:YES];
+  }
+}
