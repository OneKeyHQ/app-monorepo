{
  "name": "@onekeyhq/app-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "patch-package"
  ],
  "scripts": {
    "setup:env": "node -e \"const fs=require('fs');if(!fs.existsSync('.env'))fs.copyFileSync('.env.example','.env');\"",
    "postinstall": "node development/scripts/postinstall.js",
    "copy:inject": "node development/scripts/copy-injected.js",
    "app:desktop": "bun run --cwd apps/desktop start",
    "app:desktop:rspack": "bun run --cwd apps/desktop start:rspack",
    "app:desktop:web": "bun run --cwd apps/desktop dev:renderer",
    "app:desktop:web:rspack": "bun run --cwd apps/desktop dev:renderer:rspack",
    "app:desktop:electron": "bun run --cwd apps/desktop build:main:dev && bun run --cwd apps/desktop dev:main",
    "app:desktop:build": "bun run --cwd apps/desktop build",
    "app:ext": "bun run --cwd apps/ext start:v3",
    "app:ext:rspack": "bun run --cwd apps/ext start:v3:rspack",
    "app:ext:proxy": "bun run --cwd apps/ext start:v3:proxy",
    "app:ext:build": "bun run --cwd apps/ext build:v3",
    "app:ext:build:rspack": "bun run --cwd apps/ext build:v3:rspack",
    "app:ext:build:all": "bun run --cwd apps/ext build:all:v3",
    "app:web": "bun run app:web:no-proxy",
    "app:web:rspack": "bun run --cwd apps/web start:rspack",
    "app:web:3030": "WEB_PORT=3030 bun run app:web:no-proxy",
    "app:web:proxy": "bun run --cwd apps/web start:proxy",
    "app:web:no-proxy": "bun run --cwd apps/web start",
    "app:web:build": "bun run --cwd apps/web build",
    "app:web:build:rspack": "bun run --cwd apps/web build:rspack",
    "app:web-embed": "bun run --cwd apps/web-embed start",
    "app:web-embed:build": "bun run --cwd apps/web-embed build",
    "app:native-bundle": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" bun run --cwd apps/mobile native-bundle",
    "app:split-bundle": "bun run --cwd apps/mobile split-bundle",
    "app:build-bundle": "bun run --cwd apps/mobile build-bundle",
    "app:ios": "bun run --cwd apps/mobile ios",
    "app:ios:device": "bun run --cwd apps/mobile ios:device",
    "app:ios:pod-install": "bun run --cwd apps/mobile ios:pod-install",
    "app:android": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" bun run --cwd apps/mobile android",
    "app:android:device": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" bun run --cwd apps/mobile android:device",
    "icon:build": "bun run --cwd packages/components icon:build",
    "fetch:locale": "bun run op bun run --cwd packages/shared fetch:locale",
    "clean": "bun run --filter '*' clean && node ./development/scripts/clean_workspace.js",
    "clean:cache": "bun run --filter '*' clean:build",
    "patch:fix": "node development/patch-fix.js",
    "_tsc": "node ./development/lint/ts",
    "reinstall": "bun run clean && bun install",
    "_lint": "node ./development/lint/eslint",
    "_electron": "node ./development/lint/electron",
    "_lang": "node ./development/lint/lang",
    "_folder": "bun run --filter '*' _folderslint",
    "_packageVersions": "node ./development/lint/package-versions.js",
    "lint:project": "bun run _tsc && bun run _lint && concurrently --kill-others-on-fail \"bun run _electron\" \"bun run _folder\" \"bun run _lang\" \"bun run _packageVersions\"",
    "lint": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" bun run lint:project",
    "eslint": "sh -c 'cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" npx eslint . --ext .ts,.tsx --fix --cache --cache-location \"node_modules/.cache\"/.eslintcache'",
    "oxlint": "npx oxlint --tsconfig ./tsconfig.json --type-aware . --fix",
    "lint:only": "npx oxlint --tsconfig ./tsconfig.json --type-aware . --fix",
    "tsc:only": "npx tsgo -p ./tsconfig.json --noEmit --tsBuildInfoFile \"node_modules/.cache\"/.app-mono-ts-cache --pretty --max-old-space-size=8192",
    "test": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" bun run jest",
    "op": "./development/scripts/op-run.sh",
    "app:web:op": "bun run op bun run app:web",
    "app:ext:op": "bun run op bun run app:ext",
    "app:desktop:op": "bun run op bun run app:desktop",
    "app:ios:op": "bun run op bun run app:ios",
    "app:android:op": "bun run op bun run app:android",
    "app:native-bundle:op": "bun run op bun run app:native-bundle"
  },
