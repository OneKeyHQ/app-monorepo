{
  "name": "@onekeyhq/app-monorepo",
  "packageManager": "yarn@4.12.0",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:env": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')){if(fs.existsSync('.env.example')){fs.copyFileSync('.env.example','.env')}else{fs.writeFileSync('.env','')}}\"",
    "skills:sync": "node development/scripts/skillshare/install.js",
    "postinstall": "node development/scripts/postinstall.js",
    "copy:inject": "node development/scripts/copy-injected.js",
    "app:desktop": "yarn workspace @onekeyhq/desktop start",
    "app:desktop:web": "yarn workspace @onekeyhq/desktop dev:renderer",
    "app:desktop:electron": "yarn workspace @onekeyhq/desktop build:main:dev && yarn workspace @onekeyhq/desktop dev:main",
    "app:desktop:build": "yarn workspace @onekeyhq/desktop build",
    "app:ext": "yarn workspace @onekeyhq/ext start:v3",
    "app:ext:proxy": "yarn workspace @onekeyhq/ext start:v3:proxy",
    "app:ext:build": "yarn workspace @onekeyhq/ext build:v3",
    "app:ext:build:all": "yarn workspace @onekeyhq/ext build:all:v3",
    "stats:ext": "yarn workspace @onekeyhq/ext stats:v3",
    "app:web": "yarn app:web:no-proxy",
    "app:web:webpack": "yarn workspace @onekeyhq/web start:webpack",
    "app:web:3030": "WEB_PORT=3030 yarn app:web:no-proxy",
    "app:web:no-proxy": "yarn workspace @onekeyhq/web start",
    "app:web:build": "yarn workspace @onekeyhq/web build",
    "app:web:build:webpack": "yarn workspace @onekeyhq/web build:webpack",
    "stats:web": "yarn workspace @onekeyhq/web stats",
    "app:web-embed": "yarn workspace @onekeyhq/web-embed start",
    "app:web-embed:build": "yarn workspace @onekeyhq/web-embed build",
    "app:web-embed:restore": "yarn workspace @onekeyhq/web-embed prebundle:restore",
    "app:playground": "yarn workspace @onekeyhq/playground sb:dev",
    "app:native-bundle": "yarn workspace @onekeyhq/mobile dev-vendor:prepare && cross-env ONEKEY_DEV_VENDOR=true ONEKEY_DEV_BG_HMR=true ENABLE_NATIVE_BACKGROUND_THREAD=true NODE_OPTIONS=\"--max-old-space-size=8192\" yarn workspace @onekeyhq/mobile native-bundle",
    "app:native-bundle:bg": "cross-env ENABLE_NATIVE_BACKGROUND_THREAD=true NODE_OPTIONS=\"--max-old-space-size=8192\" yarn workspace @onekeyhq/mobile native-bundle:bg",
    "app:split-bundle": "yarn workspace @onekeyhq/mobile split-bundle",
    "app:build-bundle": "yarn workspace @onekeyhq/mobile build-bundle",
    "app:build-bundle:ios": "yarn workspace @onekeyhq/mobile build-bundle:ios",
    "app:build-bundle:android": "yarn workspace @onekeyhq/mobile build-bundle:android",
    "app:ios": "yarn workspace @onekeyhq/mobile dev-shell --platform ios",
    "app:ios:device": "yarn workspace @onekeyhq/mobile ios:device",
    "app:ios:pod-install": "yarn workspace @onekeyhq/mobile ios:pod-install",
    "app:android": "yarn workspace @onekeyhq/mobile dev-shell --platform android",
    "app:android:device": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" yarn workspace @onekeyhq/mobile android:device",
    "perf:server": "node development/performance-server/server.js",
    "perf:ios:debug": "node development/perf-ci/run-ios-perf-detox-debug.js",
    "perf:ios:release": "node development/perf-ci/run-ios-perf-detox-release.js",
    "perf:ios:release:daemon": "node development/perf-ci/run-ios-perf-detox-release-daemon.js",
    "perf:android:debug": "node development/perf-ci/run-android-perf-detox-debug.js",
    "perf:android:release": "node development/perf-ci/run-android-perf-detox-release.js",
    "perf:android:release:daemon": "node development/perf-ci/run-android-perf-detox-release-daemon.js",
    "perf:web:release": "node development/perf-ci/run-web-perf-release.js",
    "perf:web:release:daemon": "node development/perf-ci/run-web-perf-release-daemon.js",
    "perf:web:cold": "node development/perf-ci/run-web-cold.js",
    "perf:web:cold:entries": "cross-env PERF_WEB_COLD_SCENARIOS=entries PERF_WEB_COLD_BUDGET_FAIL=0 node development/perf-ci/run-web-cold.js",
    "perf:web:prepare": "node development/perf-ci/run-web-perf-prepare.js",
    "perf:desktop:release": "node development/perf-ci/run-desktop-perf-release.js",
    "perf:desktop:release:daemon": "node development/perf-ci/run-desktop-perf-release-daemon.js",
    "perf:ext:release": "node development/perf-ci/run-ext-perf-release.js",
    "perf:ext:release:daemon": "node development/perf-ci/run-ext-perf-release-daemon.js",
    "perf:release:daemon:start": "bash development/perf-ci/node-only-daemons.sh start",
    "perf:release:daemon:stop": "bash development/perf-ci/node-only-daemons.sh stop",
    "perf:release:daemon:status": "bash development/perf-ci/node-only-daemons.sh status",
    "perf:release:daemon:restart": "bash development/perf-ci/node-only-daemons.sh restart",
    "perf:release:daemon:logs": "bash development/perf-ci/node-only-daemons.sh logs",
    "icon:build": "yarn workspace @onekeyhq/components icon:build",
    "i18n:pull": "yarn op yarn workspace @onekeyhq/shared i18n:pull",
    "i18n:add": "yarn op yarn workspace @onekeyhq/shared i18n:add",
    "i18n:pull:keychain": "yarn keychain yarn workspace @onekeyhq/shared i18n:pull",
    "i18n:pull:oenv": "yarn oenv yarn workspace @onekeyhq/shared i18n:pull",
    "i18n:add:keychain": "yarn keychain yarn workspace @onekeyhq/shared i18n:add",
    "i18n:add:oenv": "yarn oenv yarn workspace @onekeyhq/shared i18n:add",
    "i18n:search": "yarn workspace @onekeyhq/shared i18n:search",
    "i18n:unused": "yarn workspace @onekeyhq/shared i18n:unused",
    "clean": "yarn workspaces foreach -A  -p run clean && node ./development/scripts/clean_workspace.js",
    "clean:cache": "yarn workspaces foreach -A run clean:build",
    "patch:fix": "node development/patch-fix.js",
    "reinstall": "yarn clean && yarn install",
    "agent:check": "node development/scripts/agent-check.js",
    "agent:review-thread": "node development/scripts/agent-review-thread.js",
    "check:third-party-async-storage": "yarn check:third-party-native-storage",
    "check:third-party-native-storage": "node apps/mobile/scripts/check-third-party-async-storage.js",
    "_tsc": "node ./development/lint/ts",
    "_lint": "node ./development/lint/eslint",
    "_electron": "node ./development/lint/electron",
    "_lang": "node ./development/lint/lang",
    "_packageVersions": "node ./development/lint/package-versions.js",
    "_font": "node ./development/lint/font.js",
    "lint:background-api-contract": "node ./development/lint/background-api-contract.js",
    "lint:agent-context": "node ./development/lint/agent-context",
    "lint:module-id": "node ./development/lint/module-id.js",
    "lint:podfile": "node ./development/lint/podfile.js",
    "lint:project": "yarn _tsc && yarn _lint && concurrently --kill-others-on-fail \"yarn _electron\" \"yarn _lang\" \"yarn _packageVersions\" \"yarn _font\" \"yarn lint:agent-context\" \"yarn lint:background-api-contract\" \"yarn lint:module-id\" \"yarn lint:podfile\"",
    "lint": "yarn lint:project",
    "lint:all": "yarn lint --fix && yarn eslint --fix",
    "eslint": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" npx eslint . --ext .ts,.tsx --fix --cache --cache-location \"$(yarn config get cacheFolder)\"/.eslintcache",
    "oxlint": "npx oxlint --tsconfig ./tsconfig.json --type-aware . --fix --deny-warnings",
    "format": "npx oxfmt \"**/*.{js,jsx,ts,tsx,mjs,cjs}\"",
    "format:check": "npx oxfmt --check \"**/*.{js,jsx,ts,tsx,mjs,cjs}\"",
    "format:staged": "node development/scripts/staged-check.js --format-only",
    "lint:only": "npx oxlint --tsconfig ./tsconfig.json --type-aware . --fix --deny-warnings && yarn format",
    "lint:staged": "node development/scripts/staged-check.js",
    "tsc:only": "node ./node_modules/@typescript/native/bin/tsc -p ./tsconfig.json --noEmit --tsBuildInfoFile \"$(yarn config get cacheFolder)\"/.app-mono-ts-cache --pretty",
    "tsc:staged": "node ./node_modules/@typescript/native/bin/tsc -p ./tsconfig.json --noEmit --tsBuildInfoFile \"$(yarn config get cacheFolder)\"/.app-mono-ts-cache --pretty",
    "test": "yarn jest",
    "test:e2e:desktop:browser": "node apps/desktop/e2e/open-url.e2e.js",
    "test:e2e:desktop:lse": "cross-env DESKTOP_E2E_FLOW=local-secret-envelope node apps/desktop/e2e/open-url.e2e.js",
    "test:e2e:desktop:sni-request": "cross-env DESKTOP_E2E_FLOW=sni-request node apps/desktop/e2e/open-url.e2e.js",
    "test:e2e:ext:lse": "node apps/ext/e2e/local-secret-envelope.e2e.js",
    "test:e2e:native:lse": "yarn test:e2e:native:lse:ios",
    "test:e2e:native:lse:android": "yarn workspace @onekeyhq/mobile harness:test:android --runTestsByPath e2e/local-secret-envelope.harness.ts && yarn workspace @onekeyhq/mobile harness:test:lse-mmkv-restart:android",
    "test:e2e:native:lse:ios": "yarn workspace @onekeyhq/mobile harness:test --runTestsByPath e2e/local-secret-envelope.harness.ts && yarn workspace @onekeyhq/mobile harness:test:lse-mmkv-restart",
    "test:e2e:web:lse": "node apps/web/e2e/local-secret-envelope.e2e.js",
    "test:unit": "yarn workspace @onekeyfe/cli test:unit",
    "test:integration:cli": "yarn workspace @onekeyfe/cli test:integration:cli",
    "ci:gate": "yarn lint:staged && yarn tsc:staged && yarn test:unit && bash apps/cli/scripts/audit-persistence-fields.sh && yarn test:integration:cli",
    "op": "./development/scripts/op-run.sh",
    "keychain": "./development/scripts/keychain-run.sh",
    "oenv": "oenv onekey-app-monorepo-env",
    "app:web:op": "yarn op yarn app:web",
    "app:ext:op": "yarn op yarn app:ext",
    "app:desktop:op": "yarn op yarn app:desktop",
    "app:ios:op": "yarn op yarn app:ios",
    "app:android:op": "yarn op yarn app:android",
    "app:native-bundle:op": "yarn op yarn app:native-bundle",
    "app:web:keychain": "yarn keychain yarn app:web",
    "app:ext:keychain": "yarn keychain yarn app:ext",
    "app:desktop:keychain": "yarn keychain yarn app:desktop",
    "app:ios:keychain": "yarn keychain yarn app:ios",
    "app:android:keychain": "yarn keychain yarn app:android",
    "app:native-bundle:keychain": "yarn keychain yarn app:native-bundle",
    "keyless:mock-server:build": "yarn workspace @onekeyhq/kit-bg keyless:mock-server:build",
    "keyless:mock-server:start": "yarn keyless:mock-server:build && node packages/kit-bg/dist/keyless-cloud-sync-mock-server/cli.js",
    "onekeyhq:modules:upgrade": "node development/scripts/upgrade-modules.js",
    "check:release-age": "npx tsx development/scripts/minimum-release-age/run.ts diff",
    "check:release-age:full": "npx tsx development/scripts/minimum-release-age/run.ts full"
  },
  "minimumReleaseAge": {
    "days": 7,
    "allowlist": [
      "@onekeyhq/*",
      "@onekeyfe/*",
      "shell-quote"
    ],
    "blockOnFailure": true,
    "registryUrl": "https://registry.npmjs.org"
  },
