<!DOCTYPE html>
<html
  font-size="16px"
   <% if ( platform === 'ext' && filename === 'ui-popup.html' ) { %>
      style="min-height: 600px; min-width: 400px; margin: 0; overflow: auto;"
   <% } %>
>
  <head>
    <meta charset="utf-8" />
    <meta httpEquiv="X-UA-Compatible" content="IE=edge" />
    <!--
        This viewport works for phones with notches.
        It's optimized for gestures by disabling global zoom.
    -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1.00001, viewport-fit=cover"
    />
    <title>OneKey</title>
    <meta name="theme-color" content="#ffffff" />
    <style>
      /* add global styles to packages/shared/src/web/index.css */
    </style>

    <% if (typeof onekeyBootstrapDataCode !== 'undefined' && onekeyBootstrapDataCode) { %>
    <script>
      <%= onekeyBootstrapDataCode %>
    </script>
    <% } %>

    <% if ( platform === 'desktop' || platform === 'web' ) { %>
    <script>
      // Start cold-start and Home display snapshot reads during HTML parsing,
      // before the application bundle competes for the main thread.
      //
      // The raw cold-start entries stay behind a Promise. hydrate.ts remains
      // responsible for build-hash validation and publishing the runtime Map.
      // Home records are also raw and are decoded by the canonical repository.
      (function () {
        try {
          var COLD_DB_NAME = 'onekey-cold-start-cache';
          var COLD_STORE_NAME = 'kv';
          var HOME_DB_NAME = 'onekey-display-snapshot-home-display';
          var HOME_STORE_NAME = 'records';
          var HOME_OWNER_KEY = 'onekey_home_latest_active_account';
          var HOME_CHUNK_IDS = ['critical', 'banner', 'portfolio', 'market'];
          var HOME_PRELOAD_TIMEOUT_MS = 250;
          var g = globalThis;

          var getIndexedDBFactory = function (bucketName) {
            var buckets = g.navigator && g.navigator.storageBuckets;
            if (!buckets) return Promise.resolve(g.indexedDB);
            return buckets
              .open(bucketName, { persisted: true, durability: 'strict' })
              .then(function (bucket) { return bucket.indexedDB; });
          };
          var openDatabase = function (name, storeName) {
            return getIndexedDBFactory(name).then(function (factory) {
              return new Promise(function (resolve, reject) {
                var request = factory.open(name, 1);
                request.onupgradeneeded = function () {
                  if (!request.result.objectStoreNames.contains(storeName)) {
                    request.result.createObjectStore(storeName);
                  }
                };
                request.onsuccess = function () { resolve(request.result); };
                request.onerror = function () { reject(request.error); };
              });
            });
          };
          var closeAfter = function (db, task) {
            return task.then(
              function (value) {
                try { db.close(); } catch (e) {}
                return value;
              },
              function (error) {
                try { db.close(); } catch (e) {}
                throw error;
              }
            );
          };
          var readAllEntries = function (db, storeName) {
            return new Promise(function (resolve, reject) {
              var entries = new Map();
              var tx = db.transaction(storeName, 'readonly');
              var request = tx.objectStore(storeName).openCursor();
              request.onsuccess = function () {
                var cursor = request.result;
                if (cursor) {
                  if (typeof cursor.key === 'string') {
                    entries.set(cursor.key, cursor.value);
                  }
                  cursor.continue();
                }
              };
              request.onerror = function () { reject(request.error); };
              tx.oncomplete = function () { resolve(entries); };
              tx.onerror = function () { reject(tx.error); };
              tx.onabort = function () { reject(tx.error); };
            });
          };
          var readMany = function (db, storeName, keys) {
            return new Promise(function (resolve, reject) {
              var values = new Map();
              if (!keys.length) {
                resolve(values);
                return;
              }
              var tx = db.transaction(storeName, 'readonly');
              var store = tx.objectStore(storeName);
              keys.forEach(function (key) {
                var request = store.get(key);
                request.onsuccess = function () {
                  if (typeof request.result === 'string') {
                    values.set(key, request.result);
                  }
                };
                request.onerror = function () { reject(request.error); };
              });
              tx.oncomplete = function () { resolve(values); };
              tx.onerror = function () { reject(tx.error); };
              tx.onabort = function () { reject(tx.error); };
            });
          };
          var withTimeout = function (task, timeoutMs) {
            return new Promise(function (resolve) {
              var settled = false;
              var timer = setTimeout(function () {
                if (settled) return;
                settled = true;
                resolve(undefined);
              }, timeoutMs);
              task.then(
                function (value) {
                  if (settled) return;
                  settled = true;
                  clearTimeout(timer);
                  resolve(value);
                },
                function () {
                  if (settled) return;
                  settled = true;
                  clearTimeout(timer);
                  resolve(undefined);
                }
              );
            });
          };

          var coldPreloadTask = openDatabase(COLD_DB_NAME, COLD_STORE_NAME)
            .then(function (db) {
              return closeAfter(db, readAllEntries(db, COLD_STORE_NAME));
            });
          g.__ONEKEY_COLD_START_IDB_PRELOAD__ = coldPreloadTask;

          var homePreloadStartedAt =
            g.performance && g.performance.now ? g.performance.now() : Date.now();
          var homePreloadTask = coldPreloadTask
            .then(function (entries) {
              var rawOwner = entries.get(HOME_OWNER_KEY);
              if (typeof rawOwner !== 'string' || !g.crypto || !g.crypto.subtle) {
                return undefined;
              }
              var owner = JSON.parse(rawOwner);
              if (
                owner.version !== 1 ||
                typeof owner.ownerScopeKey !== 'string' ||
                !owner.ownerScopeKey
              ) {
                return undefined;
              }
              return g.crypto.subtle
                .digest(
                  'SHA-256',
                  new TextEncoder().encode(owner.ownerScopeKey)
                )
                .then(function (digest) {
                  var partitionId = Array.from(new Uint8Array(digest))
                    .map(function (byte) {
                      return byte.toString(16).padStart(2, '0');
                    })
                    .join('');
                  return {
                    ownerScopeKey: owner.ownerScopeKey,
                    partitionId: partitionId,
                  };
                });
            })
            .then(function (ownerContext) {
              if (!ownerContext) return undefined;
              return openDatabase(HOME_DB_NAME, HOME_STORE_NAME).then(function (db) {
                var routeKey = 'route/' + ownerContext.partitionId;
                return closeAfter(
                  db,
                  readMany(db, HOME_STORE_NAME, [routeKey]).then(function (values) {
                    var routeRaw = values.get(routeKey);
                    if (!routeRaw) return undefined;
                    var route = JSON.parse(routeRaw);
                    if (
                      route.schemaVersion !== 1 ||
                      route.ownerScopeKey !== ownerContext.ownerScopeKey ||
                      route.partitionId !== ownerContext.partitionId ||
                      !Number.isSafeInteger(route.currentGeneration) ||
                      route.currentGeneration <= 0
                    ) {
                      return undefined;
                    }
                    var generations = [route.currentGeneration];
                    if (
                      Number.isSafeInteger(route.previousGeneration) &&
                      route.previousGeneration > 0
                    ) {
                      generations.push(route.previousGeneration);
                    }
                    var keys = [];
                    generations.forEach(function (generation) {
                      keys.push(
                        'manifest/' + ownerContext.partitionId + '/' + generation
                      );
                      HOME_CHUNK_IDS.forEach(function (chunkId) {
                        keys.push(
                          'chunk/' +
                            ownerContext.partitionId +
                            '/' +
                            generation +
                            '/' +
                            chunkId
                        );
                      });
                    });
                    return readMany(db, HOME_STORE_NAME, keys).then(function (extra) {
                      extra.forEach(function (value, key) {
                        values.set(key, value);
                      });
                      return {
                        ownerScopeKey: ownerContext.ownerScopeKey,
                        values: values,
                      };
                    });
                  })
                );
              });
            });
          g.__ONEKEY_HOME_DISPLAY_SNAPSHOT_PRELOAD__ = withTimeout(
            homePreloadTask,
            HOME_PRELOAD_TIMEOUT_MS
          ).then(function (result) {
            var completedAt =
              g.performance && g.performance.now
                ? g.performance.now()
                : Date.now();
            g.__ONEKEY_HOME_DISPLAY_SNAPSHOT_PRELOAD_RESULT__ = {
              elapsedMs: completedAt - homePreloadStartedAt,
              hit: Boolean(result),
            };
            return result;
          });
        } catch (e) {
          // Best effort: application storage remains the fallback.
        }
      })();
    </script>
    <% } %>

      <% if ( platform === 'ext' ) { %>
      <!--    <script>-->
      <!--      // ** inline script not allowed in Ext, use themePreload.js instead-->
      <!--    </script>-->
          <script src="/preload-html-head.js?<%= currentVersion %>"></script>
      <% } %>

      <% if ( platform === 'desktop' || platform === 'web' ) { %>
          <script>
// >>>>>>> automatic copy code from preload-html-head.js <<<<<<<<<
            <%= htmlHeadPreloadCode %>
          </script>
      <% } %>
      <% if ( platform == 'web-embed' ) { %> 
        <script>
          if (typeof globalThis === 'undefined') {
              var globalThis = window;
          }
        </script>
      <% } %>
      <% if ( platform !== 'ext' ) { %>
        <script>
          if (typeof window.$$onekeyStartupTimeAt === 'undefined') {
            window.$$onekeyStartupTimeAt = Date.now();
          }
        </script>
      <% } %>
  </head>

  <!-- html template copy from node_modules/@expo/webpack-config/web-default/index.html -->
  <body class="onekey-body"

        data-platform="<%= platform %>"
        data-browser="<%= browser %>"
        data-filename="<%= filename %>-not-correct-in-ext"
    <% if ( platform === 'ext' && browser === 'firefox' && filename === 'ui-popup.html' ) { %>
        style="min-height: 600px; min-width: 400px; margin: 0;"
    <% } %>
  >

    <!--
      A generic no script element with a reload button and a message.
      Feel free to customize this however you'd like.
    -->
    <noscript>
      <form
        action=""
        style="
          background-color: #fff;
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 9999;
        "
      >
        <div
          style="
            font-size: 18px;
            font-family: Helvetica, sans-serif;
            line-height: 24px;
            margin: 10%;
            width: 80%;
          "
        >
          <p>Oh no! It looks like JavaScript is not enabled in your browser.</p>
          <p style="margin: 20px 0">
            <button
              type="submit"
              style="
                background-color: #4630eb;
                border-radius: 100px;
                border: none;
                box-shadow: none;
                color: #fff;
                cursor: pointer;
                font-weight: bold;
                line-height: 20px;
                padding: 6px 16px;
              "
            >
              Reload
            </button>
          </p>
        </div>
      </form>
    </noscript>

    <!-- The root element for your Expo app.  -->
    <div id="root">
      <% if ( platform == 'web-embed' ) { %> 
        <!-- webEmbed index.html -->
      <% } %>
    </div>

    <% if ( platform !== 'ext' ) { %>
      <script>
        (()=>{
          const rootElement = document.getElementById('root');
          if (rootElement) {
            rootElement.setAttribute('data-html-render-time', Date.now().toString());
          }
        })();
      </script>
    <% } %>

    <% if ( platform !== 'web-embed' && platform !== 'web' ) { %>
      <img
        width='80'
        class="onekey-index-html-preload-image"
        style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%)"
        src="data:image/png;base64,"
      />
    <% } %>
  </body>
</html>
