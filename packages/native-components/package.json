{
  "name": "@onekeyhq/native-components",
  "version": "0.0.1",
  "private": true,
  "description": "Performance-critical native renderers for OneKey mobile",
  "main": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "ios",
    "nitrogen",
    "nitro.json",
    "OneKeyNativeComponents.podspec",
    "react-native.config.js"
  ],
  "scripts": {
    "codegen": "yarn dlx nitrogen@0.33.2 .",
    "lint": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit --tsBuildInfoFile ../../node_modules/.cache/native-components-ts-cache"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "0.33.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    }
  },
  "license": "SEE https://github.com/OneKeyHQ/app-monorepo/blob/x/LICENSE.md"
}
