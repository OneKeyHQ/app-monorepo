{
  "name": "@onekeyfe/react-native-native-overlay",
  "version": "0.1.0",
  "private": true,
  "description": "Temporary in-repo development copy of the native overlay host. Synced to OneKeyHQ/app-modules native-views/react-native-native-overlay once verified.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "files": [
    "src",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!**/__tests__"
  ],
  "codegenConfig": {
    "name": "RNCNativeOverlay",
    "type": "components",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "com.onekey.nativeoverlay"
    },
    "ios": {
      "componentProvider": {
        "RNCNativeOverlay": "RCTNativeOverlayComponentView"
      }
    }
  }
}
